# ============================================================
# ALE KIRCHA - Environment Variables
# ============================================================

# -------------------- DATABASE --------------------
# PostgreSQL (Production)
DATABASE_URL="postgresql://user:password@localhost:5432/ale_kircha?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/ale_kircha?schema=public"

# SQLite (Development)
# DATABASE_URL="file:./prisma/dev.db"

# -------------------- TELEGRAM BOTS --------------------
CUSTOMER_BOT_TOKEN="YOUR_CUSTOMER_BOT_TOKEN"
ADMIN_BOT_TOKEN="YOUR_ADMIN_BOT_TOKEN"
ADMIN_TELEGRAM_IDS="123456789,987654321"

# -------------------- API --------------------
PORT=4000
NODE_ENV=development
API_URL="http://localhost:4000"
APP_URL="http://localhost:5173"
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"
JWT_SECRET="your-super-secret-jwt-key-min-32-characters"

# -------------------- STORAGE (S3 Compatible) --------------------
S3_ENDPOINT="https://s3.example.com"
S3_REGION="us-east-1"
S3_BUCKET="ale-kircha"
S3_ACCESS_KEY="your-access-key"
S3_SECRET_KEY="your-secret-key"

# -------------------- TELEGRAM MODE --------------------
TELEGRAM_MODE="polling"  # polling | webhook

# -------------------- PAYMENT --------------------
PAYMENT_ADVICE_MAX_SIZE="5242880"  # 5MB
DEFAULT_PAYMENT_DEADLINE_MINUTES="30"
