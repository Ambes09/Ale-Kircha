// SECURITY SETTINGS
// ============================================================

bot.callbackQuery('settings_security', async (ctx) => {
  await ctx.answerCallbackQuery();
  try {
    const data = await apiCall('/api/v1/admin/settings/security');
    const settings = data.data || [];
    let msg = '🛡️ *SECURITY SETTINGS*\n\n';
    for (const s of settings) {
      msg += `📌 *${s.descriptionEn || s.settingKey}*\n`;
      msg += `   Value: ${s.settingValue}\n`;
      msg += `   ${s.isActive ? '🟢 Active' : '🔴 Inactive'}\n\n`;
    }
    await ctx.reply(msg, {
      parse_mode: 'Markdown',
      reply_markup: {
        inline_keyboard: [
          [{ text: '✏️ Edit', callback_data: 'settings_edit_security' }],
          [{ text: '🔙 Back', callback_data: 'admin_settings' }],
        ],
      },
    });
  } catch {
    await ctx.reply('❌ Failed to load security settings.');
  }
});

// ============================================================
// ALL SETTINGS
// ============================================================

bot.callbackQuery('settings_all', async (ctx) => {
  await ctx.answerCallbackQuery();
  try {
    const categories = ['group', 'payment', 'notification', 'security'];
    let msg = '📋 *ALL SETTINGS*\n\n';
    for (const cat of categories) {
      const data = await apiCall(`/api/v1/admin/settings/${cat}`);
      const settings = data.data || [];
      if (settings.length) {
        msg += `📂 *${cat.toUpperCase()}*\n`;
        for (const s of settings) {
          msg += `   📌 ${s.descriptionEn || s.settingKey}: ${s.settingValue}\n`;
        }
        msg += '\n';
      }
    }
    await ctx.reply(msg, { parse_mode: 'Markdown' });
  } catch {
    await ctx.reply('❌ Failed to load all settings.');
  }
});

// ============================================================
// EDIT SETTINGS - Category Selection
// ============================================================

bot.callbackQuery(/settings_edit_(group|payment|notification|security)/, async (ctx) => {
  await ctx.answerCallbackQuery();
  const category = ctx.match[1];
  try {
    const data = await apiCall(`/api/v1/admin/settings/${category}`);
    const settings = data.data || [];
    let msg = `✏️ *EDIT ${category.toUpperCase()} SETTINGS*\n\nSelect a setting to edit:\n\n`;
    const buttons = [];
    for (const s of settings) {
      msg += `📌 ${s.descriptionEn || s.settingKey}: ${s.settingValue}\n`;
      buttons.push([{ text: `${s.descriptionEn || s.settingKey}`, callback_data: `settings_edit_${category}_${s.settingKey}` }]);
    }
    buttons.push([{ text: '🔙 Back', callback_data: `admin_settings` }]);
    await ctx.reply(msg, {
      parse_mode: 'Markdown',
      reply_markup: {
        inline_keyboard: buttons,
      },
    });
  } catch {
    await ctx.reply('❌ Failed to load settings.');
  }
});

// ============================================================
// EDIT SPECIFIC SETTING
// ============================================================

bot.callbackQuery(/settings_edit_(group|payment|notification|security)_(.+)/, async (ctx) => {
  await ctx.answerCallbackQuery();
  const category = ctx.match[1];
  const key = ctx.match[2];
  try {
    const data = await apiCall(`/api/v1/admin/settings/${category}`);
    const settings = data.data || [];
    const setting = settings.find((s: any) => s.settingKey === key);
    if (!setting) {
      await ctx.reply('❌ Setting not found.');
      return;
    }
    await ctx.reply(
      `✏️ *EDIT SETTING*\n\n` +
      `📌 ${setting.descriptionEn || key}\n` +
      `Current Value: ${setting.settingValue}\n\n` +
      `Send the new value for this setting:`,
      {
        parse_mode: 'Markdown',
        reply_markup: {
          inline_keyboard: [
            [{ text: '🔙 Cancel', callback_data: `settings_edit_${category}` }],
          ],
        },
      }
    );
  } catch {
    await ctx.reply('❌ Failed to load setting.');
  }
});

