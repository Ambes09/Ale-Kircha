// Main About Us Screen
bot.callbackQuery('admin_about', async (ctx) => {
  await ctx.answerCallbackQuery();
  try {
    const data = await apiCall('/api/v1/about');
    const about = data.data || {};
    let msg = 'ℹ️ *ABOUT US*\n\n';
    msg += `📌 ${about.title || 'Ale Kircha'}\n\n`;
    msg += `${about.content || 'Ale Kircha - Digital meat sharing platform'}\n\n`;
    if (about.phone) msg += `📱 Phone: ${about.phone}\n`;
    if (about.email) msg += `📧 Email: ${about.email}\n`;
    if (about.address) msg += `📍 Address: ${about.address}\n`;
    if (about.telegram) msg += `📱 Telegram: ${about.telegram}\n`;
    if (about.website) msg += `🌐 Website: ${about.website}\n`;
    
    await ctx.reply(msg, {
