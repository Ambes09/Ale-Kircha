// ============================================================

bot.callbackQuery('settings_group', async (ctx) => {
  await ctx.answerCallbackQuery();
  try {
    const data = await apiCall('/api/v1/admin/settings/group');
    const settings = data.data || [];
    let msg = '🥩 *GROUP SETTINGS*\n\n';
    for (const s of settings) {
      msg += `📌 *${s.descriptionEn || s.settingKey}*\n`;
      msg += `   Value: ${s.settingValue}\n`;
      msg += `   ${s.isActive ? '🟢 Active' : '🔴 Inactive'}\n\n`;
    }
    await ctx.reply(msg, {
      parse_mode: 'Markdown',
      reply_markup: {
        inline_keyboard: [
          [{ text: '✏️ Edit', callback_data: 'settings_edit_group' }],
          [{ text: '🔙 Back', callback_data: 'admin_settings' }],
        ],
      },
    });
  } catch {
    await ctx.reply('❌ Failed to load group settings.');
  }
});

