          [{ text: '🔙 Back', callback_data: 'admin_menu' }],
          [{ text: '🏠 Main Menu', callback_data: 'admin_menu' }],
        ].filter(Boolean),
      },
    });
  } catch {
    await ctx.reply('📜 *TERMS MANAGEMENT*\n\nNo terms found.\n\n[➕ Create Terms]', {
