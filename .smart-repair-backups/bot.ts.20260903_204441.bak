// Terms List
bot.callbackQuery('terms_list', async (ctx) => {
  await ctx.answerCallbackQuery();
  try {
    const data = await apiCall('/api/v1/terms');
    const terms = data.data || [];
    let msg = '📋 *TERMS VERSIONS*\n\n';
    
    if (terms.length) {
      for (const t of terms) {
        const statusIcon = t.isActive ? '🟢' : '⚪';
        msg += `${statusIcon} *v${t.version || '1.0'}*\n`;
        msg += `   📅 ${new Date(t.effectiveFrom || t.effectiveDate).toLocaleDateString()}\n`;
        msg += `   📌 ${t.isActive ? 'CURRENT' : 'DRAFT'}\n\n`;
      }
    } else {
      msg += 'No terms found.';
    }
    
    await ctx.reply(msg, {
      parse_mode: 'Markdown',
      reply_markup: {
        inline_keyboard: [
          [{ text: '👁 Preview', callback_data: 'terms_preview' }],
          [{ text: '✏️ Edit', callback_data: 'terms_edit' }],
          [{ text: '📢 Publish', callback_data: 'terms_publish' }],
          [{ text: '➕ Create Terms', callback_data: 'terms_create' }],
          [{ text: '🔙 Back', callback_data: 'admin_terms' }],
        ],
      },
    });
  } catch {
    await ctx.reply('❌ Failed to load terms.', {
      reply_markup: { inline_keyboard: [[{ text: '🔙 Back', callback_data: 'admin_terms' }]] },
    });
  }
});

