// Main Terms Screen
bot.callbackQuery('admin_terms', async (ctx) => {
  await ctx.answerCallbackQuery();
  try {
    const data = await apiCall('/api/v1/terms');
    const terms = data.data || [];
    let msg = '📜 *TERMS MANAGEMENT*\n\n';
    
    if (terms.length) {
      for (const t of terms) {
        const statusIcon = t.isActive ? '🟢' : '⚪';
        msg += `${statusIcon} *v${t.version || '1.0'}*\n`;
        msg += `   📅 ${new Date(t.effectiveFrom || t.effectiveDate).toLocaleDateString()}\n`;
        msg += `   📌 ${t.isActive ? 'CURRENT' : 'DRAFT'}\n\n`;
      }
    } else {
      msg += 'No terms found.';
    }
    
    await ctx.reply(msg, {
      parse_mode: 'Markdown',
      reply_markup: {
        inline_keyboard: [
          [{ text: '➕ Add Terms', callback_data: 'terms_add' }],
          terms.length > 0 ? [{ text: '📋 Versions', callback_data: 'terms_versions' }] : null,
          terms.length > 0 ? [{ text: '👁 Preview', callback_data: 'terms_preview' }] : null,
          terms.length > 0 ? [{ text: '🚀 Publish', callback_data: 'terms_publish' }] : null,
          [{ text: '🔄 Refresh', callback_data: 'admin_terms' }],
          [{ text: '🔙 Back', callback_data: 'admin_menu' }],
          [{ text: '🏠 Main Menu', callback_data: 'admin_menu' }],
        ].filter(Boolean),
      },
    });
  } catch {
    await ctx.reply('📜 *TERMS MANAGEMENT*\n\nNo terms found.', {
      parse_mode: 'Markdown',
      reply_markup: {
        inline_keyboard: [
          [{ text: '➕ Add Terms', callback_data: 'terms_add' }],
          [{ text: '🏠 Main Menu', callback_data: 'admin_menu' }],
        ],
      },
    });
  }
});

