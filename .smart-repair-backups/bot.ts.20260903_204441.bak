bot.callbackQuery('settings_general', async (ctx) => {
  await ctx.answerCallbackQuery();
  try {
    const data = await apiCall('/api/v1/admin/settings/general');
    const s = data.data || {};
    let msg = '🏪 *GENERAL SETTINGS*\n\n';
    msg += `📌 Platform Name: ${s.platformNameEn || 'Ale Kircha'}\n`;
    msg += `📌 Amharic Name: ${s.platformNameAm || 'አለ ቅርጫ'}\n`;
    msg += `💰 Currency: ${s.currency || 'ETB'}\n`;
    msg += `🌐 Language: ${s.defaultLanguage || 'en'}\n`;
    msg += `🕐 Timezone: ${s.timezone || 'Africa/Addis_Ababa'}\n`;
    if (s.supportPhone) msg += `📱 Support: ${s.supportPhone}\n`;
    if (s.supportEmail) msg += `📧 Email: ${s.supportEmail}\n`;
    if (s.supportTelegram) msg += `📱 Telegram: ${s.supportTelegram}\n`;
    if (s.website) msg += `🌐 Website: ${s.website}\n`;
    
    await ctx.reply(msg, {
      parse_mode: 'Markdown',
      reply_markup: {
        inline_keyboard: [
          [{ text: '✏️ Edit', callback_data: 'settings_general_edit' }],
          [{ text: '🔙 Back', callback_data: 'admin_settings' }],
        ],
      },
    });
  } catch {
    await ctx.reply('❌ Failed to load general settings.', {
      reply_markup: { inline_keyboard: [[{ text: '🔙 Back', callback_data: 'admin_settings' }]] },
    });
  }
});

