// Report Generators
async function generateReport(ctx: any, endpoint: string, title: string) {
  try {
    const data = await apiCall(endpoint);
    const d = data.data || {};
    let msg = `📊 *${title}*\n\n`;
    if (Object.keys(d).length) {
      for (const [key, value] of Object.entries(d)) {
        msg += `📌 ${key}: ${value}\n`;
      }
    } else {
      msg += 'No data available.';
    }
    await ctx.reply(msg, {
      parse_mode: 'Markdown',
      reply_markup: {
