// Main Audit Log Screen
bot.callbackQuery('admin_audit', async (ctx) => {
  await ctx.answerCallbackQuery();
  try {
    const data = await apiCall('/api/v1/audit');
    const logs = data.data || [];
    let msg = '📋 *AUDIT LOG*\n\n';
    
    if (logs.length) {
      for (const log of logs.slice(0, 10)) {
        const emoji = log.action === 'CREATE' ? '➕' :
                      log.action === 'UPDATE' ? '✏️' :
                      log.action === 'DELETE' ? '🗑️' :
                      log.action === 'VERIFY' ? '✅' :
                      log.action === 'REJECT' ? '❌' : '📌';
        msg += `${emoji} *${log.action || 'Unknown'}*\n`;
        msg += `   👤 ${log.username || log.userId || 'System'}\n`;
        msg += `   📅 ${new Date(log.createdAt).toLocaleString()}\n`;
        msg += `   🆔 ${log.entityId?.substring(0, 8) || 'N/A'}\n\n`;
      }
      if (logs.length > 10) msg += `... ${logs.length - 10} more\n`;
    } else {
      msg += 'No audit logs found.';
    }
    
    await ctx.reply(msg, {
      parse_mode: 'Markdown',
      reply_markup: {
        inline_keyboard: [
          [{ text: '🔄 Refresh', callback_data: 'admin_audit' }],
          [{ text: '🔎 Filter', callback_data: 'audit_filter' }],
          [{ text: '👤 By Admin', callback_data: 'audit_filter_admin' }],
          [{ text: '📅 By Date', callback_data: 'audit_filter_date' }],
          [{ text: '📊 Summary', callback_data: 'audit_summary' }],
          [{ text: '📤 Export', callback_data: 'audit_export' }],
          [{ text: '🔙 Back', callback_data: 'admin_menu' }],
          [{ text: '🏠 Main Menu', callback_data: 'admin_menu' }],
        ],
      },
    });
  } catch {
    await ctx.reply('📋 *AUDIT LOG*\n\nNo audit logs found.', {
      parse_mode: 'Markdown',
      reply_markup: {
        inline_keyboard: [
          [{ text: '🔄 Refresh', callback_data: 'admin_audit' }],
          [{ text: '🔎 Filter', callback_data: 'audit_filter' }],
          [{ text: '🏠 Main Menu', callback_data: 'admin_menu' }],
        ],
      },
    });
  }
});

