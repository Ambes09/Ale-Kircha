// Ticket Filters
bot.callbackQuery(/support_(all|open|investigating|resolved|closed)/, async (ctx) => {
  await ctx.answerCallbackQuery();
  const status = ctx.match[1];
  const statusLabels: Record<string, string> = {
    all: 'ALL TICKETS',
    open: 'OPEN',
    investigating: 'INVESTIGATING',
    resolved: 'RESOLVED',
    closed: 'CLOSED'
  };
  
  await ctx.reply(`📞 *SUPPORT TICKETS - ${statusLabels[status] || 'ALL'}*\n\nNo tickets found in this category.`, {
    parse_mode: 'Markdown',
    reply_markup: {
      inline_keyboard: [[{ text: '🔙 Back', callback_data: 'admin_support' }]],
    },
  });
});

