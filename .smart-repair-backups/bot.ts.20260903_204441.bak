// Banks List
bot.callbackQuery('banks_list', async (ctx) => {
  await ctx.answerCallbackQuery();
  try {
    const data = await apiCall('/api/v1/admin/banks');
    const banks = data.data || [];
    let msg = '🏦 *BANK ACCOUNTS LIST*\n\n';
    
    if (banks.length) {
      for (const b of banks) {
        const statusIcon = b.isActive ? '🟢' : '🔴';
        msg += `${statusIcon} *${b.bankNameEn}*\n`;
        msg += `   📱 ${b.accountName}\n`;
        msg += `   🔢 ${b.accountNumber}\n`;
        if (b.isDefault) msg += `   ⭐ Default\n`;
        msg += '\n';
      }
    } else {
      msg += 'No bank accounts found.';
    }
    
    await ctx.reply(msg, {
      parse_mode: 'Markdown',
      reply_markup: {
        inline_keyboard: [
          [{ text: '👁 View Bank', callback_data: 'banks_view' }],
          [{ text: '➕ Add Bank', callback_data: 'bank_add' }],
          [{ text: '🔙 Back', callback_data: 'admin_banks' }],
        ],
      },
    });
  } catch {
    await ctx.reply('❌ Failed to load banks.', {
      reply_markup: { inline_keyboard: [[{ text: '🔙 Back', callback_data: 'admin_banks' }]] },
    });
  }
});

