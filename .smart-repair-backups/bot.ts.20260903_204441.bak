// BANK ACCOUNTS - FULL IMPLEMENTATION
// ============================================================

bot.callbackQuery('admin_banks', async (ctx) => {
  await ctx.answerCallbackQuery();
  try {
    const data = await apiCall('/api/v1/admin/banks');
    const banks = data.data || [];
    let msg = '🏦 *BANK ACCOUNTS*\n\n';
    
    if (banks.length) {
      for (const b of banks) {
        const statusIcon = b.isActive ? '🟢' : '🔴';
        msg += `${statusIcon} *${b.bankNameEn}* (${b.bankNameAm})\n`;
        msg += `   📱 ${b.accountName}\n`;
        msg += `   🔢 ${b.accountNumber}\n`;
        if (b.isDefault) msg += `   ⭐ Default\n`;
        msg += '\n';
      }
    } else {
      msg += 'No bank accounts configured.\n\n[➕ Add Bank Account]';
    }
    
    await ctx.reply(msg, {
      parse_mode: 'Markdown',
      reply_markup: {
        inline_keyboard: [
          [{ text: '➕ Add Bank Account', callback_data: 'bank_add' }],
          banks.length > 0 ? [{ text: '✏️ Edit Bank', callback_data: 'bank_edit' }] : null,
          banks.length > 0 ? [{ text: '🗑 Delete Bank', callback_data: 'bank_delete' }] : null,
          [{ text: '📋 Payment History', callback_data: 'bank_history' }],
          [{ text: '🔙 Back', callback_data: 'admin_menu' }],
          [{ text: '🏠 Main Menu', callback_data: 'admin_menu' }],
        ].filter(Boolean),
      },
    });
  } catch {
    await ctx.reply('🏦 *BANK ACCOUNTS*\n\nNo bank accounts configured.\n\n[➕ Add Bank Account]', {
      parse_mode: 'Markdown',
      reply_markup: {
        inline_keyboard: [
          [{ text: '➕ Add Bank Account', callback_data: 'bank_add' }],
          [{ text: '🏠 Main Menu', callback_data: 'admin_menu' }],
        ],
      },
    });
  }
});

