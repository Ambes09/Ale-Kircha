// Show pending group requests
bot.callbackQuery('groups_pending', async (ctx) => {
  await ctx.answerCallbackQuery();
  try {
    const data = await apiCall('/api/v1/admin/groups/pending');
    const groups = data.data || [];
    let msg = '📋 *PENDING GROUP REQUESTS*\n\n';
    
    if (groups.length) {
      for (const g of groups) {
        msg += `📌 ${g.groupId || g.id}\n`;
        msg += `   👤 ${g.customerName || 'N/A'}\n`;
        msg += `   🐂 ${g.kirchaTypeName || 'N/A'}\n`;
        msg += `   📅 ${new Date(g.createdAt).toLocaleDateString()}\n\n`;
      }
    } else {
      msg += 'No pending group requests.';
    }
    
    await ctx.reply(msg, {
      parse_mode: 'Markdown',
      reply_markup: {
        inline_keyboard: [
          [{ text: '👁 Review Request', callback_data: 'group_review' }],
          [{ text: '🔙 Back', callback_data: 'admin_groups' }],
        ],
      },
    });
  } catch {
    await ctx.reply('❌ Failed to load pending groups.', {
      reply_markup: { inline_keyboard: [[{ text: '🔙 Back', callback_data: 'admin_groups' }]] },
    });
  }
});

