// FAQ List
bot.callbackQuery('faq_list', async (ctx) => {
  await ctx.answerCallbackQuery();
  try {
    const data = await apiCall('/api/v1/faq');
    const faqs = data.data || [];
    let msg = '📋 *FAQ LIST*\n\n';
    
    if (faqs.length) {
      for (const f of faqs) {
        const statusIcon = f.isActive ? '🟢' : '🔴';
        msg += `${statusIcon} *${f.questionEn || 'N/A'}*\n`;
        msg += `   📂 ${f.category || 'general'}\n`;
        msg += `   🆔 ${f.id?.substring(0, 8)}\n\n`;
      }
    } else {
      msg += 'No FAQs found.';
    }
    
    await ctx.reply(msg, {
      parse_mode: 'Markdown',
      reply_markup: {
        inline_keyboard: [
          [{ text: '👁 View FAQ', callback_data: 'faq_view' }],
          [{ text: '➕ Add FAQ', callback_data: 'faq_add' }],
          [{ text: '🔙 Back', callback_data: 'admin_faq' }],
        ],
      },
    });
  } catch {
    await ctx.reply('❌ Failed to load FAQs.', {
      reply_markup: { inline_keyboard: [[{ text: '🔙 Back', callback_data: 'admin_faq' }]] },
    });
  }
});

