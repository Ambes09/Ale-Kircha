async function paymentAdviceConversation(conversation: any, ctx: MyContext) {
  // Payment Method
  await ctx.reply('💳 Select payment method:', {
    reply_markup: {
      inline_keyboard: [
        [{ text: '🏦 Bank Transfer', callback_data: 'pay_bank' }],
        [{ text: '📱 Telebirr', callback_data: 'pay_telebirr' }],
        [{ text: '💳 Other', callback_data: 'pay_other' }],
      ],
    },
  });
  
  const methodResult = await conversation.waitForCallbackQuery(['pay_bank', 'pay_telebirr', 'pay_other']);
  const paymentMethod = methodResult.callbackQuery.data.replace('pay_', '');
  await methodResult.answerCallbackQuery();
  
  // Amount
  await ctx.reply('💰 Enter amount paid:');
  const amountResult = await conversation.waitFor(':text');
  const amount = parseFloat(amountResult.message?.text || '0');
  
  // Transaction Reference
  await ctx.reply('📋 Enter transaction reference:');
  const refResult = await conversation.waitFor(':text');
  const reference = refResult.message?.text;
  
  // Payment Date
  await ctx.reply('📅 Enter payment date (YYYY-MM-DD):');
  const dateResult = await conversation.waitFor(':text');
  const paymentDate = dateResult.message?.text;
  
  // Upload Advice
  await ctx.reply('📎 Please upload your payment advice/receipt:');
  // File upload handled separately
  
  // Submit
  await ctx.reply('✅ Payment advice submitted for verification!');
  
  // Notify admin
  await apiCall('/api/v1/admin/notify', {
    method: 'POST',
    body: JSON.stringify({
      type: 'PAYMENT_SUBMITTED',
      title: '💳 Payment Submitted',
      message: `Payment submitted by ${ctx.from.first_name}\n\nOrder: ${ctx.session.data.orderId || 'N/A'}\nAmount: ETB ${amount}\nMethod: ${paymentMethod}\nReference: ${reference}`,
      data: {
        orderId: ctx.session.data.orderId,
        amount,
        paymentMethod,
        reference,
        paymentDate,
        customerId: ctx.session.customerId
      }
    })
  }, ctx);
}

