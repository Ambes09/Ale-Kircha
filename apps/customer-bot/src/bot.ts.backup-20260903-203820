async function apiCall(endpoint: string, options: any = {}, ctx?: MyContext) {
  const headers: any = { 'Content-Type': 'application/json' };
  if (ctx?.from?.id) headers['x-telegram-id'] = ctx.from.id.toString();
  const res = await fetch(`${API_URL}${endpoint}`, { ...options, headers });
  return res.json();
}

async function checkUser(ctx: MyContext): Promise<boolean> {
  if (ctx.session.isRegistered) return true;
  try {
    const data = await apiCall('/api/v1/customers/me', {}, ctx);
    if (data.success && data.data) {
      ctx.session.isRegistered = true;
      ctx.session.customerId = data.data.id;
      ctx.session.language = data.data.preferredLanguage || 'en';
      return true;
    }
  } catch {}
  return false;
}

// ============================================================
// REGISTRATION CONVERSATION
// ============================================================

async function registrationConversation(conversation: any, ctx: MyContext) {
  // First Name
  await ctx.reply(t(ctx, 'firstName'));
  const fn = await conversation.waitFor(':text');
  if (!fn.message?.text) { await ctx.reply(t(ctx, 'error')); return; }
  ctx.session.data.firstName = fn.message.text;

  // Last Name
  await ctx.reply(t(ctx, 'lastName'));
  const ln = await conversation.waitFor(':text');
  if (!ln.message?.text) { await ctx.reply(t(ctx, 'error')); return; }
  ctx.session.data.lastName = ln.message.text;

  // Address
  await ctx.reply(t(ctx, 'address'));
  const addr = await conversation.waitFor(':text');
  if (!addr.message?.text) { await ctx.reply(t(ctx, 'error')); return; }
  ctx.session.data.address = addr.message.text;

  // Additional Contact (Optional)
  await ctx.reply(t(ctx, 'addContact'), {
    reply_markup: {
      inline_keyboard: [
        [{ text: '📱 Add', callback_data: 'add_contact' }],
        [{ text: '⏭️ Skip', callback_data: 'skip_contact' }],
      ],
    },
  });

  const choice = await conversation.waitForCallbackQuery(['add_contact', 'skip_contact']);
  await choice.answerCallbackQuery();
  if (choice.callbackQuery.data === 'add_contact') {
    await ctx.reply(t(ctx, 'enterContact'));
    const cont = await conversation.waitFor(':text');
    if (cont.message?.text) ctx.session.data.additionalContact = cont.message.text;
  }

  // Terms
  await ctx.reply(`${t(ctx, 'terms')}\n\n${t(ctx, 'accept')}`, {
    reply_markup: {
      inline_keyboard: [
        [{ text: '✅ Accept', callback_data: 'accept_terms' }],
        [{ text: '❌ Cancel', callback_data: 'cancel_reg' }],
      ],
    },
  });

  const terms = await conversation.waitForCallbackQuery(['accept_terms', 'cancel_reg']);
  await terms.answerCallbackQuery();
  if (terms.callbackQuery.data === 'cancel_reg') {
    await ctx.reply('❌ Registration cancelled.');
    return;
  }

  ctx.session.data.termsAccepted = true;

  // Submit
  await ctx.reply('⏳ Creating account...');
  try {
    const data = await apiCall('/api/v1/customers/register', {
      method: 'POST',
      body: JSON.stringify({
        telegramId: ctx.from.id.toString(),
        username: ctx.from.username,
        firstName: ctx.session.data.firstName,
        lastName: ctx.session.data.lastName,
        phone: ctx.session.data.phone || '',
        fullName: `${ctx.session.data.firstName} ${ctx.session.data.lastName || ''}`.trim(),
        deliveryAddress: ctx.session.data.address,
        additionalContact: ctx.session.data.additionalContact || '',
        preferredLanguage: ctx.session.language || 'en',
        termsAccepted: true,
        termsVersion: '1.0',
      }),
    }, ctx);

    if (data.success) {
      ctx.session.isRegistered = true;
      ctx.session.customerId = data.data.customer?.id || data.data.user?.id;
      await ctx.reply(`🎉 ${t(ctx, 'regComplete')}`, {
        reply_markup: {
          inline_keyboard: [[{ text: '📋 Menu', callback_data: 'show_menu' }]],
        },
      });
    } else {
      await ctx.reply(`❌ ${t(ctx, 'error')}: ${data.error?.message || 'Unknown'}`);
    }
  } catch {
    await ctx.reply(`❌ ${t(ctx, 'network')}`);
  }
}

