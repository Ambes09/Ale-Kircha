async function createGroupConversation(conversation: any, ctx: MyContext) {
  // Step 1: Group Name
  await ctx.reply('📝 Enter the group name:');
  const nameResult = await conversation.waitFor(':text');
  const groupName = nameResult.message?.text;
  
  // Step 2: Kircha Type
  await ctx.reply('🐂 Select Kircha type:', {
    reply_markup: {
      inline_keyboard: [
        [{ text: '🐐 Goat', callback_data: 'group_type_goat' }],
        [{ text: '🐑 Sheep', callback_data: 'group_type_sheep' }],
        [{ text: '🐂 Ox', callback_data: 'group_type_ox' }],
      ],
    },
  });
  
  const typeResult = await conversation.waitForCallbackQuery(['group_type_goat', 'group_type_sheep', 'group_type_ox']);
  const kirchaType = typeResult.callbackQuery.data.replace('group_type_', '');
  await typeResult.answerCallbackQuery();
  
  // Step 3: Max Quota
  await ctx.reply('📊 Enter maximum quota (e.g., 5.00):');
  const quotaResult = await conversation.waitFor(':text');
  const maxQuota = parseFloat(quotaResult.message?.text || '0');
  
  // Step 4: Price
  await ctx.reply('💰 Enter amount per Full quota (ETB):');
  const priceResult = await conversation.waitFor(':text');
  const fullPrice = parseFloat(priceResult.message?.text || '0');
  
  // Step 5: Address
  await ctx.reply('📍 Enter group address:');
  const addressResult = await conversation.waitFor(':text');
  const address = addressResult.message?.text;
  
  // Step 6: Maturity Date
  await ctx.reply('📅 Enter maturity date (YYYY-MM-DD):');
  const maturityResult = await conversation.waitFor(':text');
  const maturityDate = maturityResult.message?.text;
  
  // Step 7: Expiry Date
  await ctx.reply('📅 Enter expiry date (YYYY-MM-DD):');
  const expiryResult = await conversation.waitFor(':text');
  const expiryDate = expiryResult.message?.text;
  
  // Show confirmation
  await ctx.reply(
    `📋 *CONFIRM GROUP REQUEST*\n\n` +
    `📌 Group: ${groupName}\n` +
    `🐂 Type: ${kirchaType}\n` +
    `📊 Max Quota: ${maxQuota}\n` +
    `💰 Full Price: ETB ${fullPrice}\n` +
    `📍 Address: ${address}\n` +
    `📅 Maturity: ${maturityDate}\n` +
    `📅 Expiry: ${expiryDate}\n\n` +
    `[✅ Submit for Approval] [✏️ Edit] [❌ Cancel]`,
    {
      parse_mode: 'Markdown',
      reply_markup: {
        inline_keyboard: [
          [{ text: '✅ Submit', callback_data: 'group_submit' }],
          [{ text: '✏️ Edit', callback_data: 'group_edit' }],
          [{ text: '❌ Cancel', callback_data: 'group_cancel' }],
        ],
      },
    }
  );
  
  const submitResult = await conversation.waitForCallbackQuery(['group_submit', 'group_edit', 'group_cancel']);
  await submitResult.answerCallbackQuery();
  
  if (submitResult.callbackQuery.data === 'group_submit') {
    // Submit for admin approval
    await ctx.reply('✅ Group request submitted for admin approval!');
    
    // Notify admin
    await apiCall('/api/v1/admin/notify', {
      method: 'POST',
      body: JSON.stringify({
        type: 'GROUP_REQUESTED',
        title: '📋 New Kircha Group Request',
        message: `New group request from ${ctx.from.first_name}\n\nGroup: ${groupName}\nType: ${kirchaType}\nQuota: ${maxQuota}\nPrice: ETB ${fullPrice}`,
        data: {
          groupName,
          kirchaType,
          maxQuota,
          fullPrice,
          address,
          maturityDate,
          expiryDate,
          customerId: ctx.session.customerId
        }
      })
    }, ctx);
  }
}

