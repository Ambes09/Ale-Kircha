bot.command('start', async (ctx) => {
  const isRegistered = await checkUserRegistration(ctx);
  // If already registered, show welcome back
  if (isRegistered && ctx.session.customerId) {
    // Get customer stats
    try {
      const data = await apiCall('/api/v1/customers/me', {}, ctx);
      const customer = data.data || {};
      
      await ctx.reply(
        `✅ *${t(ctx, 'welcomeBack')}*\n\n` +
        `━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n` +
        `👋 ${t(ctx, 'accountFound')}\n\n` +
        `━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n` +
        `👤 *${t(ctx, 'yourAccount')}*\n` +
        `━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n` +
        `📌 ${t(ctx, 'customerId')}: ${customer.id || 'N/A'}\n` +
        `📌 ${t(ctx, 'name')}: ${customer.fullName || 'N/A'}\n` +
        `📌 ${t(ctx, 'phone')}: ${customer.user?.phone || 'N/A'}\n` +
        `📌 ${t(ctx, 'status')}: ${customer.status || 'ACTIVE'}\n\n` +
        `━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n` +
        `📊 *${t(ctx, 'quickSummary')}*\n` +
        `━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n` +
        `${t(ctx, 'totalOrders')}: ${customer.totalOrders || 0}\n` +
        `${t(ctx, 'completedOrders')}: ${customer.completedOrders || 0}\n` +
        `${t(ctx, 'pendingOrders')}: ${customer.pendingOrders || 0}\n` +
        `${t(ctx, 'refunds')}: ${customer.refunds || 0}\n` +
        `${t(ctx, 'totalSpent')}: ${formatCurrency(customer.totalSpent || 0)}`,
        {
          parse_mode: 'Markdown',
          reply_markup: {
            inline_keyboard: [
              [{ text: '🏠 ' + t(ctx, 'goDashboard'), callback_data: 'show_menu' }],
              [{ text: '📋 ' + t(ctx, 'myOrders'), callback_data: 'menu_orders' }],
            ],
          },
        }
      );
    } catch {
      await ctx.reply(`👋 ${t(ctx, 'welcomeBack')}`, {
        reply_markup: {
          inline_keyboard: [[{ text: '🏠 ' + t(ctx, 'goDashboard'), callback_data: 'show_menu' }]],
        },
      });
    }
    return;
  }

  // New user - Show welcome screen
  await ctx.reply(
    `🥩 *${t(ctx, 'welcome')}*\n\n` +
    `━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n` +
    `📌 ${t(ctx, 'welcomeDesc')}\n\n` +
