    `━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n` +
    `${t(ctx, 'features')}\n` +
    `━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n` +
    `${t(ctx, 'feature1')}\n` +
    `${t(ctx, 'feature2')}\n` +
    `${t(ctx, 'feature3')}\n` +
    `${t(ctx, 'feature4')}\n` +
    `${t(ctx, 'feature5')}\n` +
    `${t(ctx, 'feature6')}\n\n` +
    `━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n` +
    `🌐 *${t(ctx, 'selectLanguage')}*\n` +
