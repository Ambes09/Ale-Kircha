  { en: '5. REGISTRATION OBLIGATIONS\n\nCustomers must provide accurate, complete, and current information.', am: '5. የምዝገባ ግዴታዎች\n\nደንበኞች ትክክለኛ፣ ሙሉ እና ወቅታዊ መረጃ መስጠት አለባቸው።' },
  { en: '6. GROUP PARTICIPATION\n\nCustomers may join available Kircha groups and reserve portions subject to capacity.', am: '6. የቡድን ተሳትፎ\n\nደንበኞች የሚገኙ የቅርጫ ቡድኖችን መቀላቀል እና የሚፈልጉትን ድርሻ መያዝ ይችላሉ።' },
  { en: '7. ORDERS\n\nOrders are confirmed only after payment verification.', am: '7. ትዕዛዞች\n\nትዕዛዞች የሚረጋገጡት ከክፍያ ማረጋገጫ በኋላ ብቻ ነው።' },
  { en: '8. PAYMENTS\n\nAll payments must be made through approved payment methods.', am: '8. ክፍያዎች\n\nሁሉም ክፍያዎች በተፈቀዱ የክፍያ መንገዶች መፈጸም አለባቸው።' },
  { en: '9. REFUNDS\n\nRefunds are processed according to the applicable refund policy.', am: '9. ተመላሽ ገንዘብ\n\nተመላሽ ገንዘብ በሚመለከተው ፖሊሲ መሰረት ይከናወናል።' },
  { en: '10. PRIVACY\n\nCustomer data is protected according to our Privacy Policy.', am: '10. ግላዊነት\n\nየደንበኛ መረጃ በግላዊነት ፖሊሲያችን መሰረት ይጠበቃል።' },
  { en: '11. CUSTOMER ACCEPTANCE\n\nBy clicking "I Accept", you agree to all the terms and conditions outlined above.', am: '11. የደንበኛ ተቀባይነት\n\n"ተቀብያለሁ" የሚለውን ቁልፍ በመጫን ከላይ የተገለጹትን ሁሉንም ውሎችና ሁኔታዎች እንደተስማሙባቸው ያረጋግጣሉ።' },
  { en: '12. CONTACT\n\nFor questions: support@alekircha.com', am: '12. መገኛ\n\nለጥያቄዎች፦ support@alekircha.com' },
];

// ============================================================
// TERMS CAROUSEL CONVERSATION
// ============================================================

async function termsCarouselConversation(conversation: any, ctx: MyContext) {
  const lang = ctx.session.language || 'en';
  const totalPages = termsContent.length;
  let currentPage = 0;

  while (true) {
    const content = termsContent[currentPage];
    const pageText = lang === 'en' ? content.en : content.am;
    const pageLabel = t(ctx, 'termsPage');
    
    const keyboard: any = {
      inline_keyboard: []
    };

    // Previous button
    if (currentPage > 0) {
      keyboard.inline_keyboard.push([{ text: '◀ ' + t(ctx, 'termsPrevious'), callback_data: 'terms_prev' }]);
    }

    // Next button
    if (currentPage < totalPages - 1) {
      if (currentPage > 0) {
        // If we already have a row with Prev, add Next to same row
        if (keyboard.inline_keyboard.length > 0) {
          keyboard.inline_keyboard[0].push({ text: t(ctx, 'termsNext') + ' ▶', callback_data: 'terms_next' });
        } else {
          keyboard.inline_keyboard.push([{ text: t(ctx, 'termsNext') + ' ▶', callback_data: 'terms_next' }]);
        }
      } else {
        keyboard.inline_keyboard.push([{ text: t(ctx, 'termsNext') + ' ▶', callback_data: 'terms_next' }]);
      }
    }

    // Page indicator
    keyboard.inline_keyboard.push([{ text: `📌 ${pageLabel} ${currentPage + 1}/${totalPages}`, callback_data: 'terms_page' }]);

    // Accept/Decline on last page
    if (currentPage === totalPages - 1) {
      keyboard.inline_keyboard.push([
        { text: '✅ ' + t(ctx, 'termsAccept'), callback_data: 'terms_accept' },
        { text: '❌ ' + t(ctx, 'termsDecline'), callback_data: 'terms_decline' }
      ]);
    }

    await ctx.reply(
      `📜 *${t(ctx, 'termsTitle')}*\n\n` +
      `━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n` +
      `📌 ${pageLabel} ${currentPage + 1}/${totalPages}\n` +
      `━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n` +
      `${pageText}\n\n` +
      `━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n` +
      `📖 ${t(ctx, 'termsPage')} ${currentPage + 1}/${totalPages}`,
      {
        parse_mode: 'Markdown',
        reply_markup: keyboard,
      }
    );

    const result = await conversation.waitForCallbackQuery(['terms_prev', 'terms_next', 'terms_accept', 'terms_decline', 'terms_page']);
    await result.answerCallbackQuery();

    if (result.callbackQuery.data === 'terms_prev' && currentPage > 0) {
      currentPage--;
    } else if (result.callbackQuery.data === 'terms_next' && currentPage < totalPages - 1) {
      currentPage++;
    } else if (result.callbackQuery.data === 'terms_accept') {
      ctx.session.data.termsAccepted = true;
      ctx.session.data.termsVersion = 'v1.0';
      return true;
    } else if (result.callbackQuery.data === 'terms_decline') {
      return false;
    }
  }
}

// ============================================================
// REGISTRATION CONVERSATION
// ============================================================

async function registrationConversation(conversation: any, ctx: MyContext) {
  const lang = ctx.session.language || 'en';
  
  // Step 1: Full Name
  await ctx.reply(
    `${t(ctx, 'registrationTitle')}\n\n` +
    `${t(ctx, 'personalInfo')}\n\n` +
    `${t(ctx, 'fullName')}`,
    { parse_mode: 'Markdown' }
  );
  
  const nameResult = await conversation.waitFor(':text');
  if (!nameResult.message?.text || nameResult.message.text.length < 2) {
    await ctx.reply(t(ctx, 'invalidName'));
    return;
  }
  ctx.session.data.firstName = nameResult.message.text;

  // Step 2: Address (Optional)
  await ctx.reply(
    `${t(ctx, 'registrationTitle')}\n\n` +
    `${t(ctx, 'address')}`,
    { parse_mode: 'Markdown' }
  );
  
  const addressResult = await conversation.waitFor(':text');
  if (addressResult.message?.text) {
    ctx.session.data.address = addressResult.message.text;
  }

  // Step 3: Additional Contact (Optional)
  await ctx.reply(
    `${t(ctx, 'registrationTitle')}\n\n` +
    `${t(ctx, 'additionalContact')}`,
    { parse_mode: 'Markdown' }
  );
  
  const contactResult = await conversation.waitFor(':text');
  if (contactResult.message?.text) {
    ctx.session.data.additionalContact = contactResult.message.text;
  }

  // Step 4: Terms & Conditions
  const termsAccepted = await termsCarouselConversation(conversation, ctx);
  if (!termsAccepted) {
    await ctx.reply(t(ctx, 'mustAcceptTerms'));
    return;
  }

  // Step 5: Submit Registration
  await ctx.reply('⏳ ' + (lang === 'en' ? 'Creating your account...' : 'መለያዎን በመፍጠር ላይ...'));

  try {
    const data = await apiCall(
      '/api/v1/customers/register',
      {
        method: 'POST',
        body: JSON.stringify({
          telegramId: ctx.from?.id?.toString(),
          username: ctx.from?.username || '',
          firstName: ctx.session.data.firstName,
          lastName: '',
          phone: ctx.session.data.phone || ctx.session.phoneNumber || '',
          fullName: ctx.session.data.firstName,
          deliveryAddress: ctx.session.data.address || '',
          additionalContact: ctx.session.data.additionalContact || '',
          preferredLanguage: ctx.session.language || 'en',
          termsAccepted: true,
          termsVersion: ctx.session.data.termsVersion || 'v1.0',
        }),
      },
      ctx
    );

    if (data.success) {
      ctx.session.isRegistered = true;
      ctx.session.customerId = data.data.customer?.id || data.data.user?.id;
      
      // Notify admin
      try {
        await apiCall('/api/v1/admin/notify', {
          method: 'POST',
          body: JSON.stringify({
            type: 'CUSTOMER_REGISTERED',
            title: '🔔 New Customer Registered',
            message: `👤 New customer registered!\n\nCustomer ID: ${ctx.session.customerId}\nName: ${ctx.session.data.firstName}\nPhone: ${ctx.session.data.phone}\nTelegram: @${ctx.from?.username || 'N/A'}\nLanguage: ${ctx.session.language}`,
            data: {
              customerId: ctx.session.customerId,
              firstName: ctx.session.data.firstName,
              phone: ctx.session.data.phone,
              telegramId: ctx.from?.id,
              username: ctx.from?.username,
              language: ctx.session.language
            }
          })
        }, ctx);
      } catch (error) {
        console.error('Failed to notify admin:', error);
      }

      // Registration Complete
      await ctx.reply(
        `✅ *${t(ctx, 'regComplete')}*\n\n` +
        `━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n` +
        `🎉 ${t(ctx, 'regWelcome')}\n\n` +
        `${t(ctx, 'regSuccess')}\n\n` +
        `━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n` +
        `👤 *${t(ctx, 'yourDetails')}*\n` +
        `━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n` +
        `📌 ${t(ctx, 'customerId')}: ${ctx.session.customerId || 'N/A'}\n` +
        `📌 ${t(ctx, 'name')}: ${ctx.session.data.firstName}\n` +
        `📌 ${t(ctx, 'phone')}: ${ctx.session.data.phone || 'N/A'}\n` +
        `📌 ${t(ctx, 'language')}: ${ctx.session.language === 'en' ? 'English' : 'አማርኛ'}\n` +
        `📌 ${t(ctx, 'registrationDate')}: ${new Date().toLocaleDateString()}\n` +
        `📌 ${t(ctx, 'status')}: ACTIVE\n\n` +
        `━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n` +
        `📋 *${t(ctx, 'whatsNext')}*\n` +
        `━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n` +
        `${t(ctx, 'whatsNext1')}\n` +
        `${t(ctx, 'whatsNext2')}\n` +
        `${t(ctx, 'whatsNext3')}\n` +
        `${t(ctx, 'whatsNext4')}\n\n` +
        `━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n` +
        `🚀 *${t(ctx, 'getStarted')}*\n` +
        `━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━`,
        {
          parse_mode: 'Markdown',
          reply_markup: {
            inline_keyboard: [
              [{ text: '🏠 ' + t(ctx, 'goMainMenu'), callback_data: 'show_menu' }],
              [{ text: '🛒 ' + t(ctx, 'viewAvailable'), callback_data: 'menu_groups' }],
            ],
          },
        }
      );
    } else {
      await ctx.reply(`❌ ${t(ctx, 'error')}: ${data.error?.message || 'Unknown error'}`);
    }
  } catch (error) {
    await ctx.reply(`❌ ${t(ctx, 'networkError')}`);
  }
}

