// Get all fees
fastify.get('/api/v1/admin/fees', async (request, reply) => {
  try {
    const result = await db.query('SELECT * FROM "FeeConfiguration" ORDER BY "createdAt" DESC');
    return { success: true, data: result.rows };
  } catch (error: any) {
    return { success: false, error: error.message };
  }
});

// Create fee
fastify.post('/api/v1/admin/fees', async (request, reply) => {
  try {
    const body = request.body as any;
    const result = await db.query(`
      INSERT INTO "FeeConfiguration" (name, "nameAm", type, value, category, "isActive")
      VALUES ($1, $2, $3, $4, $5, $6)
      RETURNING *
    `, [body.name, body.nameAm, body.type, body.value, body.category, body.isActive !== false]);
    return { success: true, data: result.rows[0] };
  } catch (error: any) {
    return { success: false, error: error.message };
  }
});

// Update fee
fastify.put('/api/v1/admin/fees/:id', async (request, reply) => {
  try {
    const { id } = request.params as any;
    const body = request.body as any;
    const result = await db.query(`
      UPDATE "FeeConfiguration" 
      SET name = $1, "nameAm" = $2, type = $3, value = $4, category = $5, "isActive" = $6, "updatedAt" = new Date()
      WHERE id = $7
      RETURNING *
    `, [body.name, body.nameAm, body.type, body.value, body.category, body.isActive, id]);
    if (result.rows.length === 0) {
      return { success: false, error: 'Fee not found' };
    }
    return { success: true, data: result.rows[0] };
  } catch (error: any) {
    return { success: false, error: error.message };
  }
});

// Delete fee
fastify.delete('/api/v1/admin/fees/:id', async (request, reply) => {
  try {
    const { id } = request.params as any;
    const result = await db.query('DELETE FROM "FeeConfiguration" WHERE id = $1 RETURNING id', [id]);
    if (result.rows.length === 0) {
      return { success: false, error: 'Fee not found' };
    }
    return { success: true, data: { deleted: true } };
  } catch (error: any) {
    return { success: false, error: error.message };
  }
});

