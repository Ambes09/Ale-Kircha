import Fastify from 'fastify';
import cors from '@fastify/cors';
import helmet from '@fastify/helmet';
import { Client } from 'pg';

const fastify = Fastify({ logger: true });

// Database client
const db = new Client({
  connectionString: process.env.DATABASE_URL || 'postgresql://localhost:5432/ale_kircha',
});

// Connect to database
db.connect().then(() => {
  console.log('✅ PostgreSQL connected');
}).catch((err: any) => {
  console.error('❌ Database connection failed:', err.message);
  process.exit(1);
});

// Register plugins
fastify.register(cors, { origin: true });
fastify.register(helmet);

// ============================================================
// HEALTH CHECK
// ============================================================

fastify.get('/health', async () => {
  try {
    await db.query('SELECT 1');
    return { status: 'ok', database: 'connected', service: 'ale-kircha-api' };
  } catch {
    return { status: 'error', database: 'disconnected' };
  }
});

// ============================================================
// ADMIN DASHBOARD STATS
// ============================================================

fastify.get('/api/v1/admin/stats', async () => {
  try {
    const users = await db.query('SELECT COUNT(*) FROM "User"');
    const customers = await db.query('SELECT COUNT(*) FROM "Customer"');
    const groups = await db.query('SELECT COUNT(*) FROM "Groups"');
    const orders = await db.query('SELECT COUNT(*) FROM "Orders"');
    const payments = await db.query('SELECT COUNT(*) FROM "Payments" WHERE status = $1', ['PENDING']);
    const revenue = await db.query('SELECT COALESCE(SUM("totalAmount"), 0) FROM "Orders" WHERE "orderStatus" = $1', ['COMPLETED']);
    
    return {
      success: true,
      data: {
        users: parseInt(users.rows[0].count),
        customers: parseInt(customers.rows[0].count),
        groups: parseInt(groups.rows[0].count),
        orders: parseInt(orders.rows[0].count),
        payments: parseInt(payments.rows[0].count),
        revenue: parseFloat(revenue.rows[0].coalesce)
      }
    };
  } catch (error: any) {
    return { success: false, error: error.message };
  }
});

