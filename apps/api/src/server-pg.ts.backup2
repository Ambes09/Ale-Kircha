// ---------- About ----------
fastify.get('/api/v1/about', async (request, reply) => {
  try {
    // Check if about table exists, if not create it
    await db.query(`
      CREATE TABLE IF NOT EXISTS "About" (
        id TEXT PRIMARY KEY DEFAULT gen_random_uuid()::text,
        title TEXT NOT NULL DEFAULT 'Ale Kircha',
        content TEXT NOT NULL DEFAULT 'Ale Kircha is a digital meat-sharing platform.',
        "updatedAt" TIMESTAMP DEFAULT NOW()
      )
    `);
    const result = await db.query('SELECT * FROM "About" LIMIT 1');
    if (result.rows.length === 0) {
      await db.query(`
        INSERT INTO "About" (title, content) VALUES 
        ('Ale Kircha', 'Ale Kircha is a digital meat-sharing platform that connects customers with organized Kircha groups.')
      `);
      const newResult = await db.query('SELECT * FROM "About" LIMIT 1');
      return { success: true, data: newResult.rows[0] };
    }
    return { success: true, data: result.rows[0] };
  } catch (error: any) {
    return { success: false, error: error.message };
  }
});

// ---------- Self Help ----------
fastify.get('/api/v1/selfhelp', async (request, reply) => {
  try {
    // Create self help table if not exists
    await db.query(`
      CREATE TABLE IF NOT EXISTS "SelfHelp" (
        id TEXT PRIMARY KEY DEFAULT gen_random_uuid()::text,
        "titleEn" TEXT NOT NULL,
        "titleAm" TEXT NOT NULL,
        "contentEn" TEXT NOT NULL,
        "contentAm" TEXT NOT NULL,
        category TEXT DEFAULT 'general',
        "displayOrder" INTEGER DEFAULT 0,
        "isActive" BOOLEAN DEFAULT true,
        "createdAt" TIMESTAMP DEFAULT NOW(),
        "updatedAt" TIMESTAMP DEFAULT NOW()
      )
    `);
    const result = await db.query('SELECT * FROM "SelfHelp" ORDER BY "displayOrder"');
    return { success: true, data: result.rows };
  } catch (error: any) {
    return { success: false, error: error.message };
  }
});

