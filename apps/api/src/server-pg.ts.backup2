// ---------- Reports ----------
fastify.get('/api/v1/admin/reports/sales', async (request, reply) => {
  try {
    const total = await db.query('SELECT COALESCE(SUM("totalAmount"), 0) FROM "Orders" WHERE "orderStatus" = $1', ['COMPLETED']);
    const count = await db.query('SELECT COUNT(*) FROM "Orders" WHERE "orderStatus" = $1', ['COMPLETED']);
    const avg = await db.query('SELECT COALESCE(AVG("totalAmount"), 0) FROM "Orders" WHERE "orderStatus" = $1', ['COMPLETED']);
    return {
      success: true,
      data: {
        'Total Revenue': parseFloat(total.rows[0].coalesce).toFixed(2),
        'Orders Completed': parseInt(count.rows[0].count),
        'Average Order Value': parseFloat(avg.rows[0].coalesce).toFixed(2)
      }
    };
  } catch (error: any) {
    return { success: false, error: error.message };
  }
});

fastify.get('/api/v1/admin/reports/orders', async (request, reply) => {
  try {
    const pending = await db.query('SELECT COUNT(*) FROM "Orders" WHERE "orderStatus" = $1', ['PENDING_PAYMENT']);
    const inprogress = await db.query('SELECT COUNT(*) FROM "Orders" WHERE "orderStatus" = $1', ['IN_PROGRESS']);
    const completed = await db.query('SELECT COUNT(*) FROM "Orders" WHERE "orderStatus" = $1', ['COMPLETED']);
    const cancelled = await db.query('SELECT COUNT(*) FROM "Orders" WHERE "orderStatus" = $1', ['CANCELLED']);
    return {
      success: true,
      data: {
        'Pending': parseInt(pending.rows[0].count),
        'In Progress': parseInt(inprogress.rows[0].count),
        'Completed': parseInt(completed.rows[0].count),
        'Cancelled': parseInt(cancelled.rows[0].count)
      }
    };
  } catch (error: any) {
    return { success: false, error: error.message };
  }
});

