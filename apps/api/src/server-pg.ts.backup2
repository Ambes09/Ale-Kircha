import Fastify from 'fastify';
import cors from '@fastify/cors';
import helmet from '@fastify/helmet';
import { Client } from 'pg';

const fastify = Fastify({ logger: true });

// Database client
const db = new Client({
  connectionString: process.env.DATABASE_URL || 'postgresql://localhost:5432/ale_kircha',
});

// Connect to database
db.connect().then(() => {
  console.log('✅ PostgreSQL connected');
}).catch(err => {
  console.error('❌ Database connection failed:', err.message);
  process.exit(1);
});

// Register plugins BEFORE routes
fastify.register(cors, { origin: true });
fastify.register(helmet);

// ============================================================
// ROUTES - ALL DEFINED BEFORE LISTENING
// ============================================================

// Health check
fastify.get('/health', async () => {
  try {
    await db.query('SELECT 1');
    return { status: 'ok', database: 'connected', service: 'ale-kircha-api' };
  } catch {
    return { status: 'error', database: 'disconnected' };
  }
});

// API Version
fastify.get('/api/v1/health', async () => {
  return {
    status: 'ok',
    service: 'ale-kircha-api',
    version: '1.0.0',
    timestamp: new Date().toISOString()
  };
});

// Customer Registration
fastify.post('/api/v1/customers/register', async (request, reply) => {
  try {
    const { telegramId, phoneNumber, firstName, lastName } = request.body as any;

    if (!telegramId) {
      return reply.status(400).send({
        success: false,
        error: { code: 'VALIDATION_ERROR', message: 'telegramId is required' }
      });
    }

    // Check if user exists
    const existing = await db.query(
      'SELECT * FROM "User" WHERE "telegramId" = $1',
      [String(telegramId)]
    );

    if (existing.rows.length > 0) {
      return {
        success: true,
        data: { user: existing.rows[0], status: 'EXISTING' }
      };
    }

    // Create new user
    const result = await db.query(
      `INSERT INTO "User" (id, "telegramId", "firstName", "lastName", phone, role, "createdAt", "updatedAt")
       VALUES (gen_random_uuid()::text, $1, $2, $3, $4, 'CUSTOMER', NOW(), NOW())
       RETURNING *`,
      [String(telegramId), firstName || 'User', lastName || '', phoneNumber || '']
    );

    const user = result.rows[0];

    // Create customer record
    const customerResult = await db.query(
      `INSERT INTO "Customer" (id, "userId", "fullName", "additionalPhone", "preferredLanguage", "registrationDate", "status")
       VALUES (gen_random_uuid()::text, $1, $2, $3, 'en', NOW(), 'ACTIVE')
       RETURNING *`,
      [user.id, firstName + ' ' + (lastName || ''), '']
    );

    return {
      success: true,
      data: {
        user: user,
        customer: customerResult.rows[0],
        status: 'CREATED'
      }
    };
  } catch (error: any) {
    fastify.log.error(error);
    return reply.status(500).send({
      success: false,
      error: { code: 'INTERNAL_ERROR', message: error.message }
    });
  }
});

// Customer profile
fastify.get('/api/v1/customers/me', async (request, reply) => {
  try {
    const telegramId = request.headers['x-telegram-id'];
    if (!telegramId) {
      return reply.status(401).send({
        success: false,
        error: { code: 'UNAUTHORIZED', message: 'Missing Telegram ID' }
      });
    }

    const result = await db.query(
      `SELECT c.*, u.* FROM "Customer" c
       JOIN "User" u ON c."userId" = u.id
       WHERE u."telegramId" = $1`,
      [String(telegramId)]
    );

    if (result.rows.length === 0) {
      return reply.status(404).send({
        success: false,
        error: { code: 'NOT_FOUND', message: 'Customer not found' }
      });
    }

    return { success: true, data: result.rows[0] };
  } catch (error: any) {
    return reply.status(500).send({
      success: false,
      error: { code: 'INTERNAL_ERROR', message: error.message }
    });
  }
});

// Admin stats
fastify.get('/api/v1/admin/stats', async () => {
  const [users, customers, orders, groups] = await Promise.all([
    db.query('SELECT COUNT(*) FROM "User"'),
    db.query('SELECT COUNT(*) FROM "Customer"'),
    db.query('SELECT COUNT(*) FROM "Order"'),
    db.query('SELECT COUNT(*) FROM "KirchaGroup"'),
  ]);

  return {
    success: true,
    data: {
      users: parseInt(users.rows[0].count),
      customers: parseInt(customers.rows[0].count),
      orders: parseInt(orders.rows[0].count),
      groups: parseInt(groups.rows[0].count),
    }
  };
});

// Debug - list users
fastify.get('/api/v1/debug/users', async () => {
  const result = await db.query('SELECT id, "telegramId", "firstName", "lastName", phone FROM "User" LIMIT 10');
  return { success: true, data: result.rows };
});

// ============================================================
// START SERVER
// ============================================================

const start = async () => {
  const port = Number(process.env.PORT) || 4000;
  const host = process.env.HOST || '0.0.0.0';

  await fastify.listen({ port, host });
  console.log(`🚀 API running on ${host}:${port}`);
  console.log(`📊 Health: http://${host}:${port}/health`);
};

start().catch(err => {
  console.error('❌ Failed to start API:', err.message);
  process.exit(1);
});

