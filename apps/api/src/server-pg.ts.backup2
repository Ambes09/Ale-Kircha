// Self Help
fastify.get('/api/v1/selfhelp', async (request, reply) => {
  try {
    // Create self help articles if none exist
    await db.query(`
      CREATE TABLE IF NOT EXISTS "SelfHelp" (
        id TEXT PRIMARY KEY DEFAULT gen_random_uuid()::text,
        "titleEn" TEXT NOT NULL,
        "titleAm" TEXT NOT NULL,
        "contentEn" TEXT NOT NULL,
        "contentAm" TEXT NOT NULL,
        category TEXT DEFAULT 'general',
        "displayOrder" INTEGER DEFAULT 0,
        "isActive" BOOLEAN DEFAULT true,
        "createdAt" TIMESTAMP DEFAULT NOW(),
        "updatedAt" TIMESTAMP DEFAULT NOW()
      )
    `);
    
    // Insert sample if empty
    const count = await db.query('SELECT COUNT(*) FROM "SelfHelp"');
    if (parseInt(count.rows[0].count) === 0) {
      await db.query(`
        INSERT INTO "SelfHelp" ("titleEn", "titleAm", "contentEn", "contentAm") VALUES 
        ('How to use Ale Kircha', 'አሌ ቅርጫን እንዴት መጠቀም እንደሚቻል', 
         'Step by step guide to using Ale Kircha...', 
         'አሌ ቅርጫን ለመጠቀም ደረጃ በደረጃ መመሪያ...')
      `);
    }
    
    const result = await db.query('SELECT * FROM "SelfHelp" ORDER BY "displayOrder"');
    return { success: true, data: result.rows };
  } catch (error) {
    return { success: false, error: error.message };
  }
});

// Fees
fastify.get('/api/v1/fees', async (request, reply) => {
  try {
    const category = request.query.category || '';
    let query = 'SELECT * FROM "FeeConfiguration"';
    if (category) {
      query += ` WHERE category = $1`;
    }
    const result = await db.query(query, category ? [category] : []);
    return { success: true, data: result.rows };
  } catch (error) {
    return { success: false, error: error.message };
  }
});

// Reports
fastify.get('/api/v1/admin/reports/:type', async (request, reply) => {
  try {
    const type = (request.params as any).type;
    const results: any = {};
    
    switch(type) {
      case 'sales':
        const sales = await db.query('SELECT COUNT(*) as count, COALESCE(SUM("totalAmount"), 0) as total FROM "Orders" WHERE "orderStatus" = $1', ['COMPLETED']);
        results['Total Sales'] = sales.rows[0].total;
        results['Orders'] = sales.rows[0].count;
        break;
      case 'orders':
        const pending = await db.query('SELECT COUNT(*) FROM "Orders" WHERE "orderStatus" = $1', ['PENDING_PAYMENT']);
        const completed = await db.query('SELECT COUNT(*) FROM "Orders" WHERE "orderStatus" = $1', ['COMPLETED']);
        const cancelled = await db.query('SELECT COUNT(*) FROM "Orders" WHERE "orderStatus" = $1', ['CANCELLED']);
        results['Pending'] = pending.rows[0].count;
        results['Completed'] = completed.rows[0].count;
        results['Cancelled'] = cancelled.rows[0].count;
        break;
      case 'payments':
        const paid = await db.query('SELECT COUNT(*) FROM "Payments" WHERE status = $1', ['VERIFIED']);
        const unpaid = await db.query('SELECT COUNT(*) FROM "Payments" WHERE status = $1', ['PENDING']);
        results['Verified'] = paid.rows[0].count;
        results['Pending'] = unpaid.rows[0].count;
        break;
      case 'customers':
        const total = await db.query('SELECT COUNT(*) FROM "Customer"');
        const active = await db.query('SELECT COUNT(*) FROM "Customer" WHERE status = $1', ['ACTIVE']);
        results['Total'] = total.rows[0].count;
        results['Active'] = active.rows[0].count;
        break;
      case 'groups':
        const open = await db.query('SELECT COUNT(*) FROM "Groups" WHERE status = $1', ['OPEN']);
        const full = await db.query('SELECT COUNT(*) FROM "Groups" WHERE status = $1', ['FULL']);
        results['Open'] = open.rows[0].count;
        results['Full'] = full.rows[0].count;
        break;
    }
    
    return { success: true, data: results };
  } catch (error) {
    return { success: false, error: error.message };
  }
});

