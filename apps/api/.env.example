# Database
DATABASE_URL="postgresql://user:password@localhost:5432/siga_kircha?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/siga_kircha?schema=public"

# Telegram Bots
CUSTOMER_BOT_TOKEN="YOUR_CUSTOMER_BOT_TOKEN"
ADMIN_BOT_TOKEN="YOUR_ADMIN_BOT_TOKEN"

# JWT
JWT_SECRET="your-strong-secret"

# App URLs
APP_URL="http://localhost:5173"
API_URL="http://localhost:4000"
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"

# Object Storage (S3-compatible)
S3_ENDPOINT="https://s3.example.com"
S3_REGION="us-east-1"
S3_BUCKET="siga-kircha"
S3_ACCESS_KEY="your-access-key"
S3_SECRET_KEY="your-secret-key"

# Misc
PORT=4000
NODE_ENV=development
PAYMENT_ADVICE_MAX_SIZE="5242880" # 5MB
DEFAULT_PAYMENT_DEADLINE_MINUTES=30
TELEGRAM_MODE="polling"
ADMIN_TELEGRAM_IDS=678862323,5228276799
