// FAQ Manage - List
bot.callbackQuery('faq_manage', async (ctx) => {
  await ctx.answerCallbackQuery();
  try {
    const data = await apiCall('/api/v1/faq');
    const faqs = data.data || [];
    let msg = ' *MANAGE FAQS*\n\nSelect a FAQ to manage:\n\n';
    
    if (faqs.length) {
      for (const f of faqs) {
        const statusIcon = f.isActive ? '' : '';
        msg += '${statusIcon} *${f.questionEn || 'N/A'}*\n';\n        msg += '    ${f.id?.substring(0, 8) || 'N/A'}\n\n';\n      }\n    } else {\n      msg += 'No FAQs found.';
    }
    
    await ctx.reply(msg, {
      parse_mode: 'Markdown',
      reply_markup: {
        inline_keyboard: [
          [{ text: ' View', callback_data: 'faq_view' }],
          [{ text: ' Edit', callback_data: 'faq_edit' }],
          [{ text: ' Toggle', callback_data: 'faq_toggle' }],
          [{ text: ' Delete', callback_data: 'faq_delete' }],
          [{ text: ' Reorder', callback_data: 'faq_reorder' }],
          [{ text: ' Back', callback_data: 'admin_faq' }],
        ],
      },
    });
  } catch {
    await ctx.reply(' Failed to load FAQs.', {
      reply_markup: { inline_keyboard: [[{ text: ' Back', callback_data: 'admin_faq' }]] },
    });
  }
});

