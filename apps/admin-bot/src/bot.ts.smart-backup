bot.callbackQuery('admin_users', async (ctx) => {
  await ctx.answerCallbackQuery();
  try {
    const data = await apiCall('/api/v1/admin/users');
    const users = data.data || [];
    let msg = ' *ADMIN USERS*\n\n';
    if (users.length) {
      for (const u of users.slice(0, 10)) {
        msg += ' ${u.username || u.telegramId || 'N/A'}\n    ${u.role || 'ADMIN'}\n   ${u.isActive ? ' Active' : ' Inactive'}\n\n';\n      }\n    } else {\n      msg += 'No admin users found.';
    }
    await ctx.reply(msg, { parse_mode: 'Markdown' });
  } catch {
    await ctx.reply(' Failed to load admin users.');
  }
});

