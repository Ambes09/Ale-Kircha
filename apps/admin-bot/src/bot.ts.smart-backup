// REPORTS - SUMMARY DASHBOARD
// ============================================================

// Reports Summary
bot.callbackQuery('reports_summary', async (ctx) => {
  await ctx.answerCallbackQuery();
  try {
    // Get all report data in parallel
    const [orders, payments, customers, refunds, delivery] = await Promise.all([
      apiCall('/api/v1/admin/reports/orders'),
      apiCall('/api/v1/admin/reports/payments'),
      apiCall('/api/v1/admin/reports/customers'),
      apiCall('/api/v1/admin/reports/refunds'),
      apiCall('/api/v1/admin/reports/delivery')
    ]);
    
    const o = orders.data || {};
    const p = payments.data || {};
    const c = customers.data || {};
    const r = refunds.data || {};
    const d = delivery.data || {};
    
    const msg = ' *REPORTS SUMMARY*\n\n' +
      '\n' +\n      ' *ORDERS*\n' +\n      '\n' +\n      'Total: ${o.total || 0}\n' +\n      'Completed: ${o.completed || 0}\n' +\n      'Pending: ${o.pending || 0}\n\n' +\n      '\n' +\n      ' *PAYMENTS*\n' +\n      '\n' +\n      'Verified: ${p.verified || 0}\n' +\n      'Pending: ${p.pending || 0}\n' +\n      'Rejected: ${p.rejected || 0}\n\n' +\n      '\n' +\n      ' *CUSTOMERS*\n' +\n      '\n' +\n      'Total: ${c.total || 0}\n' +\n      'Active: ${c.active || 0}\n' +\n      'New (7d): ${c.new || 0}\n\n' +\n      '\n' +\n      ' *REFUNDS*\n' +\n      '\n' +\n      'Pending: ${r.pending || 0}\n' +\n      'Approved: ${r.approved || 0}\n' +\n      'Completed: ${r.completed || 0}\n\n' +\n      '\n' +\n      ' *DELIVERY*\n' +\n      '\n' +\n      'Pending: ${d.pending || 0}\n' +\n      'In Progress: ${d.inProgress || 0}\n' +\n      'Completed: ${d.completed || 0}';\n    \n    await ctx.reply(msg, {\n      parse_mode: 'Markdown',
      reply_markup: {
        inline_keyboard: [
          [{ text: ' Full Reports', callback_data: 'admin_reports' }],
          [{ text: ' Refresh', callback_data: 'reports_summary' }],
          [{ text: ' Back', callback_data: 'admin_menu' }],
        ],
      },
    });
  } catch {
    await ctx.reply(' Failed to load reports summary.', {
      reply_markup: { inline_keyboard: [[{ text: ' Back', callback_data: 'admin_menu' }]] },
    });
  }
});

// ============================================================
// MISSING HANDLERS - CLEAN UP
// ============================================================

// Handle any remaining callback queries
// This catches any callbacks that don't have specific handlers

// Generic handler for any unhandled callbacks
bot.callbackQuery(/.*/, async (ctx) => {
  // Only handle if no specific handler caught it
  // This is a fallback
  const data = ctx.callbackQuery.data;
  if (data) {
    // Check if this is a known callback that might have been missed
    const knownCallbacks = [
      'admin_dashboard', 'admin_customers', 'admin_groups', 'admin_orders',
      'admin_payments', 'admin_refunds', 'admin_delivery', 'admin_reports',
      'admin_fees', 'admin_settings', 'admin_users', 'admin_audit',
      'admin_support', 'admin_faq', 'admin_terms', 'admin_about',
      'admin_banks', 'admin_notifications', 'admin_selfhelp', 'admin_language',
      'admin_menu', 'admin_privacy'
    ];
    
    if (!knownCallbacks.includes(data) && !data.startsWith('report_') && 
        !data.startsWith('settings_') && !data.startsWith('fees_') &&
        !data.startsWith('bank_') && !data.startsWith('terms_') &&
        !data.startsWith('faq_') && !data.startsWith('users_') &&
        !data.startsWith('delivery_') && !data.startsWith('orders_') &&
        !data.startsWith('payments_') && !data.startsWith('refunds_') &&
        !data.startsWith('customers_') && !data.startsWith('groups_') &&
        !data.startsWith('support_') && !data.startsWith('about_') &&
        !data.startsWith('lang_')) {
      await ctx.answerCallbackQuery();
      await ctx.reply(' *${data.replace('_', ' ').toUpperCase()}*\n\nFeature coming soon.', {\n        parse_mode: 'Markdown',\n        reply_markup: {\n          inline_keyboard: [[{ text: ' Menu', callback_data: 'admin_menu' }]],
        },
      });
    }
  }
});

