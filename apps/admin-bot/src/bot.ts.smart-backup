// Users List
bot.callbackQuery('users_list', async (ctx) => {
  await ctx.answerCallbackQuery();
  try {
    const data = await apiCall('/api/v1/admin/users');
    const users = data.data || [];
    let msg = ' *ADMIN USERS LIST*\n\n';
    
    if (users.length) {
      for (const u of users) {
        const statusIcon = u.isActive ? '' : '';
        msg += '${statusIcon} *${u.username || u.telegramId || 'N/A'}*\n';\n        msg += '    ${u.role || 'ADMIN'}\n';\n        msg += '    ${u.telegramId || 'N/A'}\n\n';\n      }\n    } else {\n      msg += 'No admin users found.';
    }
    
    await ctx.reply(msg, {
