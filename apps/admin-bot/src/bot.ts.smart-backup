// ============================================================
// ALL SETTINGS
// ============================================================

bot.callbackQuery('settings_all', async (ctx) => {
  await ctx.answerCallbackQuery();
  try {
    const categories = ['group', 'payment', 'notification', 'security'];
    let msg = ' *ALL SETTINGS*\n\n';
    for (const cat of categories) {
      const data = await apiCall('/api/v1/admin/settings/${cat}');\n      const settings = data.data || [];\n      if (settings.length) {\n        msg += ' *${cat.toUpperCase()}*\n';\n        for (const s of settings) {\n          msg += '    ${s.descriptionEn || s.settingKey}: ${s.settingValue}\n';\n        }\n        msg += '\n';\n      }
    }
    await ctx.reply(msg, { parse_mode: 'Markdown' });
  } catch {
    await ctx.reply(' Failed to load all settings.');
  }
});

// ============================================================
// EDIT SETTINGS - Category Selection
// ============================================================

bot.callbackQuery(/settings_edit_(group|payment|notification|security)/, async (ctx) => {
  await ctx.answerCallbackQuery();
  const category = ctx.match[1];
  try {
    const data = await apiCall('/api/v1/admin/settings/${category}');\n    const settings = data.data || [];\n    let msg = ' *EDIT ${category.toUpperCase()} SETTINGS*\n\nSelect a setting to edit:\n\n';\n    const buttons = [];\n    for (const s of settings) {\n      msg += ' ${s.descriptionEn || s.settingKey}: ${s.settingValue}\n';\n      buttons.push([{ text: '${s.descriptionEn || s.settingKey}', callback_data: 'settings_edit_${category}_${s.settingKey}' }]);\n    }\n    buttons.push([{ text: ' Back', callback_data: 'admin_settings' }]);\n    await ctx.reply(msg, {\n      parse_mode: 'Markdown',\n      reply_markup: {
        inline_keyboard: buttons,
      },
    });
  } catch {
    await ctx.reply(' Failed to load settings.');
  }
});

// ============================================================
// EDIT SPECIFIC SETTING
// ============================================================

bot.callbackQuery(/settings_edit_(group|payment|notification|security)_(.+)/, async (ctx) => {
  await ctx.answerCallbackQuery();
  const category = ctx.match[1];
  const key = ctx.match[2];
  try {
    const data = await apiCall('/api/v1/admin/settings/${category}');\n    const settings = data.data || [];\n    const setting = settings.find((s: any) => s.settingKey === key);\n    if (!setting) {
      await ctx.reply(' Setting not found.');
      return;
    }
    await ctx.reply(
      ' *EDIT SETTING*\n\n' +\n      ' ${setting.descriptionEn || key}\n' +\n      'Current Value: ${setting.settingValue}\n\n' +\n      'Send the new value for this setting:',\n      {\n        parse_mode: 'Markdown',\n        reply_markup: {
          inline_keyboard: [
            [{ text: ' Cancel', callback_data: 'settings_edit_${category}' }]],\n        },\n      }\n    );
  } catch {
    await ctx.reply(' Failed to load setting.');
  }
});

