bot.callbackQuery('admin_support', async (ctx) => {
  await ctx.answerCallbackQuery();
  try {
    const data = await apiCall('/api/v1/support/tickets');
    const tickets = data.data || [];
    let msg = ' *SUPPORT TICKETS*\n\n';
    
    if (tickets.length) {
      for (const t of tickets.slice(0, 10)) {
        const emoji = t.status === 'OPEN' ? '' : t.status === 'INVESTIGATING' ? '' : t.status === 'RESOLVED' ? '' : '';
        msg += '${emoji} *${t.ticketId || t.id}*\n';\n        msg += '    ${t.customerName || 'N/A'}\n';\n        msg += '    ${t.category || 'General'}\n';\n        msg += '    ${new Date(t.createdAt).toLocaleString()}\n\n';\n      }\n      if (tickets.length > 10) msg += '... ${tickets.length - 10} more\n';\n    } else {\n      msg += 'No support tickets found.';\n    }
    
    await ctx.reply(msg, {
      parse_mode: 'Markdown',
      reply_markup: {
        inline_keyboard: [
          [{ text: ' All Tickets', callback_data: 'support_all' }],
          [{ text: ' Open', callback_data: 'support_open' }],
          [{ text: ' Investigating', callback_data: 'support_investigating' }],
          [{ text: ' Resolved', callback_data: 'support_resolved' }],
          [{ text: ' Closed', callback_data: 'support_closed' }],
          [{ text: ' Search', callback_data: 'support_search' }],
          [{ text: ' Back', callback_data: 'admin_menu' }],
          [{ text: ' Main Menu', callback_data: 'admin_menu' }]],
      },
    });
  } catch {
    await ctx.reply(' *SUPPORT TICKETS*\n\nNo support tickets found.', {
      parse_mode: 'Markdown',
      reply_markup: {
        inline_keyboard: [
          [{ text: ' Refresh', callback_data: 'admin_support' }],
          [{ text: ' Main Menu', callback_data: 'admin_menu' }]],
      },
    });
  }
});

