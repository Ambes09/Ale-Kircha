// Self Help - View Articles
bot.callbackQuery('admin_selfhelp', async (ctx) => {
  await ctx.answerCallbackQuery();
  try {
    const data = await apiCall('/api/v1/selfhelp');
    const articles = data.data || [];
    let msg = ' *SELF HELP ARTICLES*\n\n';
    
    if (articles.length) {
      for (const a of articles.slice(0, 10)) {
        const statusIcon = a.isActive ? '' : '';
        msg += '${statusIcon} *${a.titleEn || 'N/A'}*\n';\n        msg += '    ${a.category || 'general'}\n\n';\n      }\n      if (articles.length > 10) msg += '... ${articles.length - 10} more\n';\n    } else {\n      msg += 'No self help articles found.';\n    }
    
    await ctx.reply(msg, {
      parse_mode: 'Markdown',
      reply_markup: {
        inline_keyboard: [
          [{ text: ' Add Article', callback_data: 'selfhelp_add' }],
          [{ text: ' Edit', callback_data: 'selfhelp_edit' }],
