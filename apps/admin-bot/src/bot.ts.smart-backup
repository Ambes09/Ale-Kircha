  try {
    const data = await apiCall('/api/v1/admin/banks');
    const banks = data.data || [];
    let msg = ' *DELETE BANK ACCOUNT*\n\nSelect a bank to delete:\n\n';
    
    if (banks.length) {
      const buttons = banks.filter((b: any) => !b.isDefault).map((b: any) => ([
        { text: ' ${b.bankNameEn}', callback_data: 'bank_delete_${b.id}' }\n      ]));\n      buttons.push([{ text: ' Back', callback_data: 'admin_banks' }]);\n      
      await ctx.reply(msg + ' Default bank cannot be deleted.', {
        parse_mode: 'Markdown',
        reply_markup: { inline_keyboard: buttons },
      });
    } else {
      await ctx.reply('No bank accounts to delete.', {
        reply_markup: { inline_keyboard: [[{ text: ' Back', callback_data: 'admin_banks' }]] },
      });
    }
