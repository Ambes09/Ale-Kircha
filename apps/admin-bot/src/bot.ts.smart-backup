    if (users.length) {
      for (const u of users.slice(0, 10)) {
        const statusIcon = u.isActive ? '' : '';
        msg += '${statusIcon} *${u.username || u.telegramId || 'N/A'}*\n';\n        msg += '    ${u.role || 'ADMIN'}\n';\n        msg += '    ${u.telegramId || 'N/A'}\n\n';\n      }\n      if (users.length > 10) msg += '... ${users.length - 10} more\n';\n    } else {\n      msg += 'No admin users found.\n\n[ Add Admin]';\n    }
    
    await ctx.reply(msg, {
      parse_mode: 'Markdown',
      reply_markup: {
        inline_keyboard: [
          [{ text: ' Add Admin', callback_data: 'users_add' }],
          users.length > 0 ? [{ text: ' Edit Admin', callback_data: 'users_edit' }] : null,
          [{ text: ' Back', callback_data: 'admin_menu' }],
          [{ text: ' Main Menu', callback_data: 'admin_menu' }]] => item !== null),
      },
