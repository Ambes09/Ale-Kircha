// Bank Edit/Delete Confirm
bot.callbackQuery(/bank_(edit|delete)_(.+)/, async (ctx) => {
  await ctx.answerCallbackQuery();
  const action = ctx.match[1];
  const id = ctx.match[2];
  
  if (action === 'edit') {
    await ctx.reply(' *EDIT BANK*\n\nSend updated details for bank ID: ${id}', {\n      parse_mode: 'Markdown',\n      reply_markup: { inline_keyboard: [[{ text: ' Back', callback_data: 'admin_banks' }]] },\n    });
  } else if (action === 'delete') {
    await ctx.reply(' *CONFIRM DELETE*\n\nAre you sure you want to delete this bank account?\n\nBank ID: ${id}', {\n      parse_mode: 'Markdown',\n      reply_markup: {\n        inline_keyboard: [
          [{ text: ' Yes, Delete', callback_data: 'bank_confirm_delete_${id}' }],\n          [{ text: ' Cancel', callback_data: 'admin_banks' }],\n        ],\n      },
    });
  }
});

// Bank Confirm Delete
bot.callbackQuery(/bank_confirm_delete_(.+)/, async (ctx) => {
  await ctx.answerCallbackQuery();
  const id = ctx.match[1];
  try {
    const result = await apiCall('/api/v1/admin/banks/${id}', { method: 'DELETE' }, ctx);\n    if (result.success) {\n      await ctx.reply(' Bank account deleted successfully!', {\n        reply_markup: { inline_keyboard: [[{ text: ' Back', callback_data: 'admin_banks' }]] },
      });
    } else {
      await ctx.reply(' Failed to delete: ${result.error || 'Unknown error'}', {\n        reply_markup: { inline_keyboard: [[{ text: ' Back', callback_data: 'admin_banks' }]] },\n      });\n    }
  } catch {
    await ctx.reply(' Failed to delete bank account.', {
      reply_markup: { inline_keyboard: [[{ text: ' Back', callback_data: 'admin_banks' }]] },
    });
  }
});

