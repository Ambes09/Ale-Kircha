// Self Help - Main Menu
bot.callbackQuery('admin_selfhelp', async (ctx) => {
  await ctx.answerCallbackQuery();
  try {
    const data = await apiCall('/api/v1/selfhelp');
    const articles = data.data || [];
    let msg = ' *SELF HELP MANAGEMENT*\n\n';
    if (articles.length) {
      msg += ' Total Articles: ${articles.length}\n\n';\n      for (const a of articles.slice(0, 10)) {\n        const statusIcon = a.isActive ? '' : '';\n        msg += '${statusIcon} *${a.titleEn || 'N/A'}*\n';\n        msg += '    ${a.category || 'general'}\n';\n        msg += '    ${a.id?.substring(0, 8) || 'N/A'}\n\n';\n      }\n      if (articles.length > 10) msg += '... ${articles.length - 10} more\n';\n    } else {\n      msg += 'No self help articles found.\n\n[ Add Article]';\n    }
    
    await ctx.reply(msg, {
      parse_mode: 'Markdown',
      reply_markup: {
        inline_keyboard: [
          [{ text: ' Add Article', callback_data: 'selfhelp_add' }],
          articles.length > 0 ? [{ text: ' Edit', callback_data: 'selfhelp_edit' }] : null,
          articles.length > 0 ? [{ text: ' Toggle', callback_data: 'selfhelp_toggle' }] : null,
          articles.length > 0 ? [{ text: ' Delete', callback_data: 'selfhelp_delete' }] : null,
          [{ text: ' Refresh', callback_data: 'admin_selfhelp' }],
          [{ text: ' Back', callback_data: 'admin_menu' }],
          [{ text: ' Main Menu', callback_data: 'admin_menu' }],
        ].filter(Boolean),
      },
    });
  } catch {
    await ctx.reply(' *SELF HELP*\n\nNo articles found.\n\n[ Add Article]', {
      parse_mode: 'Markdown',
      reply_markup: {
        inline_keyboard: [
          [{ text: ' Add Article', callback_data: 'selfhelp_add' }],
          [{ text: ' Main Menu', callback_data: 'admin_menu' }],
        ],
      },
    });
  }
});

