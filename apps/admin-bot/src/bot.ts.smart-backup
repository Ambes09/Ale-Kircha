// Admin Users Manage
bot.callbackQuery('users_manage', async (ctx) => {
  await ctx.answerCallbackQuery();
  try {
    const data = await apiCall('/api/v1/admin/users');
    const users = data.data || [];
    let msg = ' *MANAGE ADMINS*\n\nSelect an admin to manage:\n\n';
    
    if (users.length) {
      for (const u of users) {
        const statusIcon = u.isActive ? '' : '';
        msg += '${statusIcon} *${u.username || u.telegramId || 'N/A'}*\n';\n        msg += '    ${u.role || 'ADMIN'}\n';\n        msg += '    ${u.telegramId || 'N/A'}\n\n';\n      }\n    } else {\n      msg += 'No admin users found.';
    }
    
    await ctx.reply(msg, {
      parse_mode: 'Markdown',
      reply_markup: {
        inline_keyboard: [
          [{ text: ' View', callback_data: 'users_view' }],
          [{ text: ' Edit Role', callback_data: 'users_edit' }],
          [{ text: ' Toggle', callback_data: 'users_toggle' }],
          [{ text: ' Remove', callback_data: 'users_delete' }],
          [{ text: ' Add Admin', callback_data: 'users_add' }],
          [{ text: ' Back', callback_data: 'admin_users' }],
        ],
      },
    });
  } catch {
    await ctx.reply(' Failed to load admin users.', {
      reply_markup: { inline_keyboard: [[{ text: ' Back', callback_data: 'admin_users' }]] },
    });
  }
});

