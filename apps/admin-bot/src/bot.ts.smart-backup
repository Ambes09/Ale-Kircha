          [{ text: ' Cancel', callback_data: 'admin_support' }],
        ],
      },
    }
  );
});

// Support Tickets - All
bot.callbackQuery('support_all', async (ctx) => {
  await ctx.answerCallbackQuery();
  try {
    const data = await apiCall('/api/v1/support/tickets');
    const tickets = data.data || [];
    let msg = ' *ALL SUPPORT TICKETS*\n\n';
    
    if (tickets.length) {
      for (const t of tickets.slice(0, 10)) {
        const emoji = t.status === 'OPEN' ? '' : 
                      t.status === 'INVESTIGATING' ? '' : 
                      t.status === 'RESOLVED' ? '' : '';
        msg += '${emoji} *${t.ticketId || t.id}*\n';\n        msg += '    ${t.customerName || 'N/A'}\n';\n        msg += '    ${t.category || 'General'}\n';\n        msg += '    ${new Date(t.createdAt).toLocaleString()}\n\n';\n      }\n      if (tickets.length > 10) msg += '... ${tickets.length - 10} more\n';\n    } else {\n      msg += 'No support tickets found.';\n    }
    
    await ctx.reply(msg, {
      parse_mode: 'Markdown',
      reply_markup: {
        inline_keyboard: [
          [{ text: ' View', callback_data: 'support_view' }],
          [{ text: ' Refresh', callback_data: 'support_all' }],
          [{ text: ' Back', callback_data: 'admin_support' }],
        ],
      },
    });
  } catch {
    await ctx.reply(' Failed to load tickets.', {
      reply_markup: { inline_keyboard: [[{ text: ' Back', callback_data: 'admin_support' }]] },
    });
  }
});

