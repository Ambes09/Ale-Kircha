bot.callbackQuery(/delivery_(pending|assigned|out|completed)/, async (ctx) => {
  await ctx.answerCallbackQuery();
  const status = ctx.match[1];
  const labels: Record<string, string> = {
    pending: 'PENDING',
    assigned: 'ASSIGNED',
    out: 'OUT FOR DELIVERY',
    completed: 'COMPLETED'
  };
  
  await ctx.reply(' *DELIVERY - ${labels[status] || status.toUpperCase()}*\n\nNo deliveries found in this category.', {\n    parse_mode: 'Markdown',\n    reply_markup: {\n      inline_keyboard: [[{ text: ' Back', callback_data: 'admin_delivery' }]],
    },
  });
});

