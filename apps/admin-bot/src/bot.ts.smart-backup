// Delivery Status Management
bot.callbackQuery(/delivery_(pending|assigned|out|completed)/, async (ctx) => {
  await ctx.answerCallbackQuery();
  const status = ctx.match[1];
  try {
    const data = await apiCall('/api/v1/deliveries');
    const filtered = (data.data || []).filter((d: any) => {
      if (status === 'pending') return d.status === 'PENDING' || d.status === 'UNASSIGNED';
      if (status === 'assigned') return d.status === 'ASSIGNED';
      if (status === 'out') return d.status === 'OUT_FOR_DELIVERY';
      if (status === 'completed') return d.status === 'DELIVERED' || d.status === 'COMPLETED';
      return false;
    });
    const labels: Record<string, string> = {
      pending: 'PENDING',
      assigned: 'ASSIGNED',
      out: 'OUT FOR DELIVERY',
      completed: 'COMPLETED'
    };
    let msg = ' *DELIVERY - ${labels[status] || status.toUpperCase()}*\n\n';\n    if (filtered.length) {\n      for (const d of filtered.slice(0, 10)) {\n        msg += ' ${d.orderNumber || d.id}\n';\n        msg += '    ${d.customerName || 'N/A'}\n\n';\n      }\n      if (filtered.length > 10) msg += '... ${filtered.length - 10} more\n';\n    } else {\n      msg += 'No ${status} deliveries.';\n    }\n    await ctx.reply(msg, {\n      parse_mode: 'Markdown',
      reply_markup: {
        inline_keyboard: [[{ text: ' Back', callback_data: 'admin_delivery' }]],
      },
    });
  } catch {
    await ctx.reply(' Failed to load deliveries.', {
      reply_markup: { inline_keyboard: [[{ text: ' Back', callback_data: 'admin_delivery' }]] },
    });
  }
});

