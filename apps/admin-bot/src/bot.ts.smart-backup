// Customer Stats
bot.callbackQuery('customers_stats', async (ctx) => {
  await ctx.answerCallbackQuery();
  try {
    const data = await apiCall('/api/v1/customers');
    const customers = data.data || [];
    const total = customers.length;
    const active = customers.filter((c: any) => c.status === 'ACTIVE').length;
    const suspended = customers.filter((c: any) => c.status === 'SUSPENDED').length;
    const blocked = customers.filter((c: any) => c.status === 'BLOCKED').length;
    
    await ctx.reply(
      ' *CUSTOMER STATISTICS*\n\n' +
      ' Total Customers: ${total}\n' +\n      ' Active: ${active}\n' +\n      ' Suspended: ${suspended}\n' +\n      ' Blocked: ${blocked}\n\n' +\n      ' Last 7 days: ${customers.filter((c: any) => new Date(c.createdAt) > new Date(Date.now() - 7*24*60*60*1000)).length} new',\n      {\n        parse_mode: 'Markdown',\n        reply_markup: {
          inline_keyboard: [[{ text: ' Back', callback_data: 'admin_customers' }]],
        },
      }
    );
  } catch {
    await ctx.reply(' Failed to load stats.', {
      reply_markup: { inline_keyboard: [[{ text: ' Back', callback_data: 'admin_customers' }]] },
    });
  }
});

