// Orders Summary
bot.callbackQuery('orders_summary', async (ctx) => {
  await ctx.answerCallbackQuery();
  try {
    const data = await apiCall('/api/v1/orders');
    const orders = data.data || [];
    const total = orders.length;
    const pending = orders.filter((o: any) => o.orderStatus === 'PENDING' || o.orderStatus === 'PENDING_PAYMENT').length;
    const verified = orders.filter((o: any) => o.orderStatus === 'PAYMENT_VERIFIED').length;
    const inProgress = orders.filter((o: any) => o.orderStatus === 'IN_PROGRESS').length;
    const completed = orders.filter((o: any) => o.orderStatus === 'COMPLETED').length;
    const cancelled = orders.filter((o: any) => o.orderStatus === 'CANCELLED').length;
    const totalValue = orders.reduce((sum: number, o: any) => sum + Number(o.totalAmount || 0), 0);
    
    await ctx.reply(
      ' *ORDER SUMMARY*\n\n' +
      ' Total Orders: ${total}\n' +\n      ' Pending: ${pending}\n' +\n      ' Verified: ${verified}\n' +\n      ' In Progress: ${inProgress}\n' +\n      ' Completed: ${completed}\n' +\n      ' Cancelled: ${cancelled}\n\n' +\n      ' Total Value: ${formatCurrency(totalValue)}',\n      {\n        parse_mode: 'Markdown',\n        reply_markup: {
          inline_keyboard: [[{ text: ' Back', callback_data: 'admin_orders' }]],
        },
      }
    );
  } catch {
    await ctx.reply(' Failed to load summary.', {
      reply_markup: { inline_keyboard: [[{ text: ' Back', callback_data: 'admin_orders' }]] },
    });
  }
});

