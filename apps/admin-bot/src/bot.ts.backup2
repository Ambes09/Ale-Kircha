bot.callbackQuery('admin_delivery', async (ctx) => {
  await ctx.answerCallbackQuery();
  const result = await safeApiCall('/api/v1/deliveries', {}, ctx);
  const deliveries = result.data || [];
  let msg = '🚚 *DELIVERY*\n\n';
  if (deliveries.length) {
    for (const d of deliveries.slice(0, 10)) {
      const emoji = d.status === 'PENDING' ? '🟡' : d.status === 'OUT_FOR_DELIVERY' ? '🚚' : '✅';
      msg += `${emoji} *${d.order?.orderNumber || 'N/A'}*\n`;
      msg += `   👤 ${d.customer?.fullName || 'N/A'}\n`;
      msg += `   📍 ${d.deliveryAddress || 'N/A'}\n\n`;
    }
    if (deliveries.length > 10) msg += `... ${deliveries.length - 10} more\n`;
  } else {
    msg += 'No deliveries found.';
  }
  if (result.mock) msg += '\nℹ️ Demo data';
  await ctx.reply(msg, {
    parse_mode: 'Markdown',
    reply_markup: {
      inline_keyboard: [
        [{ text: '📋 Pending', callback_data: 'delivery_pending' }, { text: '🚚 Out', callback_data: 'delivery_out' }],
        [{ text: '✅ Delivered', callback_data: 'delivery_delivered' }, { text: '🔙 Menu', callback_data: 'admin_menu' }],
      ],
    },
  });
});

// Delivery sub-filters
bot.callbackQuery(/delivery_(pending|out|delivered)/, async (ctx) => {
  await ctx.answerCallbackQuery();
  const status = ctx.match[1];
  const result = await safeApiCall('/api/v1/deliveries', {}, ctx);
  const filtered = (result.data || []).filter((d: any) => {
    if (status === 'pending') return d.status === 'PENDING' || d.status === 'UNASSIGNED';
    if (status === 'out') return d.status === 'OUT_FOR_DELIVERY' || d.status === 'ASSIGNED';
    if (status === 'delivered') return d.status === 'DELIVERED' || d.status === 'COMPLETED';
    return false;
  });
  let msg = `🚚 *DELIVERY - ${status.toUpperCase()}*\n\n`;
  if (filtered.length) {
    for (const d of filtered.slice(0, 10)) {
      msg += `📌 ${d.order?.orderNumber || 'N/A'}\n   👤 ${d.customer?.fullName || 'N/A'}\n\n`;
    }
    if (filtered.length > 10) msg += `... ${filtered.length - 10} more\n`;
  } else {
    msg += `No ${status} deliveries.`;
  }
  await ctx.reply(msg, {
    parse_mode: 'Markdown',
    reply_markup: { inline_keyboard: [[{ text: '🔙 Back', callback_data: 'admin_delivery' }]] },
  });
});

