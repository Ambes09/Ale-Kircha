// ============================================================
// REPORTS - Generate summaries
// ============================================================

async function generateReport(ctx: any, type: string) {
  try {
    let endpoint = '';
    let title = '';
    let fields: any = {};
    switch(type) {
      case 'sales':
        endpoint = '/api/v1/admin/reports/sales';
        title = '📊 SALES REPORT';
        break;
      case 'orders':
        endpoint = '/api/v1/admin/reports/orders';
        title = '📦 ORDER REPORT';
        break;
      case 'payments':
        endpoint = '/api/v1/admin/reports/payments';
        title = '💳 PAYMENT REPORT';
        break;
      case 'customers':
        endpoint = '/api/v1/admin/reports/customers';
        title = '👥 CUSTOMER REPORT';
        break;
      case 'groups':
        endpoint = '/api/v1/admin/reports/groups';
        title = '🥩 GROUP REPORT';
        break;
      default:
        throw new Error('Unknown report type');
    }
    const data = await apiCall(endpoint, {}, ctx);
    const d = data.data || {};
    let msg = `*${title}*\n\n`;
    for (const [key, value] of Object.entries(d)) {
      msg += `${key}: ${value}\n`;
    }
    await ctx.reply(msg || 'No data available.', {
      parse_mode: 'Markdown',
      reply_markup: {
        inline_keyboard: [
          [{ text: '🔙 Back', callback_data: 'admin_reports' }],
        ],
      },
    });
  } catch {
    await ctx.reply('❌ Failed to load report.', { reply_markup: { inline_keyboard: [[{ text: '🔙 Back', callback_data: 'admin_reports' }]] } });
  }
}

bot.callbackQuery('report_sales', async (ctx) => {
  await ctx.answerCallbackQuery();
  await generateReport(ctx, 'sales');
});

bot.callbackQuery('report_orders', async (ctx) => {
  await ctx.answerCallbackQuery();
  await generateReport(ctx, 'orders');
});

bot.callbackQuery('report_payments', async (ctx) => {
