bot.callbackQuery('admin_groups', async (ctx) => {
  await ctx.answerCallbackQuery();
  const result = await safeApiCall('/api/v1/kircha/groups', {}, ctx);
  const groups = result.data || [];
  let msg = '🥩 *GROUPS*\n\n';
  if (groups.length) {
    for (const g of groups.slice(0, 10)) {
      const avail = (g.maxQuota || 0) - (g.consumedQuota || 0);
      const emoji = g.status === 'OPEN' ? '🟢' : g.status === 'FULL' ? '📦' : '⚪';
      msg += `${emoji} *${g.name || 'N/A'}*\n`;
      msg += `   📦 ${avail.toFixed(1)}/${g.maxQuota || 0}\n`;
      msg += `   💰 ${formatCurrency(g.fullPrice || 0)}\n\n`;
    }
    if (groups.length > 10) msg += `... ${groups.length - 10} more\n`;
  } else {
    msg += 'No groups found.';
  }
  if (result.mock) msg += '\nℹ️ Demo data';
  await ctx.reply(msg, {
    parse_mode: 'Markdown',
    reply_markup: {
      inline_keyboard: [
        [{ text: '➕ Create', callback_data: 'groups_create' }, { text: '🟢 Open', callback_data: 'groups_open' }],
        [{ text: '✅ Completed', callback_data: 'groups_completed' }, { text: '🔙 Menu', callback_data: 'admin_menu' }],
      ],
    },
  });
});

