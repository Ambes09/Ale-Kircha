    const data = await apiCall('/api/v1/orders', {}, ctx);
    let msg = '❌ *CANCELLED ORDERS*\n\n';
    const cancelled = data.data?.filter((o: any) => o.orderStatus === 'CANCELLED') || [];
    if (cancelled.length) {
      for (const o of cancelled.slice(0, 10)) {
        msg += `📌 ${o.orderNumber}\n`;
        msg += `   💰 ${formatCurrency(o.totalAmount || 0)}\n`;
        msg += `   👤 ${o.customer?.fullName || 'N/A'}\n\n`;
      }
      if (cancelled.length > 10) msg += `... ${cancelled.length - 10} more\n`;
    } else {
      msg += 'No cancelled orders found.';
    }
    await ctx.reply(msg, {
      parse_mode: 'Markdown',
      reply_markup: {
        inline_keyboard: [
          [{ text: '🔙 Back', callback_data: 'admin_orders' }],
        ],
      },
    });
  } catch {
    await ctx.reply('❌ Failed.', { reply_markup: { inline_keyboard: [[{ text: '🔙 Back', callback_data: 'admin_orders' }]] } });
  }
});

