bot.callbackQuery('customers_active', async (ctx) => {
  await ctx.answerCallbackQuery();
  try {
    const data = await apiCall('/api/v1/customers', {}, ctx);
    let msg = '🟢 *ACTIVE CUSTOMERS*\n\n';
    const active = data.data?.filter((c: any) => c.status === 'ACTIVE') || [];
    if (active.length) {
      for (const c of active.slice(0, 10)) {
        msg += `📛 ${c.fullName || 'N/A'}\n`;
        msg += `   📱 ${c.user?.phone || 'N/A'}\n`;
        msg += `   📅 ${new Date(c.registrationDate).toLocaleDateString()}\n\n`;
      }
      if (active.length > 10) msg += `... ${active.length - 10} more\n`;
    } else {
      msg += 'No active customers found.';
    }
    await ctx.reply(msg, {
      parse_mode: 'Markdown',
      reply_markup: {
        inline_keyboard: [
          [{ text: '🔙 Back', callback_data: 'admin_customers' }],
        ],
      },
    });
  } catch {
    await ctx.reply('❌ Failed.', { reply_markup: { inline_keyboard: [[{ text: '🔙 Back', callback_data: 'admin_customers' }]] } });
  }
});

