// ============================================================
// FEES & CHARGES - Lists
// ============================================================

async function listFees(ctx: any, category: string, title: string) {
  try {
    const data = await apiCall(`/api/v1/fees?category=${category}`, {}, ctx);
    let msg = `💵 *${title}*\n\n`;
    const fees = data.data || [];
    if (fees.length) {
      for (const f of fees.slice(0, 10)) {
        msg += `📌 ${f.name}\n`;
        msg += `   ${f.type}: ${f.value}\n`;
        msg += `   ${f.isActive ? '🟢 Active' : '🔴 Inactive'}\n\n`;
      }
      if (fees.length > 10) msg += `... ${fees.length - 10} more\n`;
    } else {
      msg += 'No fees configured.';
    }
    await ctx.reply(msg, {
      parse_mode: 'Markdown',
      reply_markup: {
        inline_keyboard: [
          [{ text: '➕ Add', callback_data: `fee_add_${category}` }],
          [{ text: '🔙 Back', callback_data: 'admin_fees' }],
        ],
      },
    });
  } catch {
    await ctx.reply('❌ Failed.', { reply_markup: { inline_keyboard: [[{ text: '🔙 Back', callback_data: 'admin_fees' }]] } });
  }
}

