// ============================================================
// SAFE API CALL WITH FALLBACK
// ============================================================

async function safeApiCall(endpoint: string, options: any = {}, ctx?: any) {
  try {
    const data = await apiCall(endpoint, options, ctx);
    if (data.success && data.data) {
      return { success: true, data: data.data };
    }
    // If API fails or returns empty, use mock data
    const mockKey = endpoint.split('/').pop() || '';
    const mock = mockData[mockKey as keyof typeof mockData];
    if (mock) {
      return { success: true, data: mock, mock: true };
    }
    return { success: false, data: [], mock: true };
  } catch {
    // On error, return mock data
    const mockKey = endpoint.split('/').pop() || '';
    const mock = mockData[mockKey as keyof typeof mockData];
    if (mock) {
      return { success: true, data: mock, mock: true };
    }
    return { success: false, data: [], mock: true };
  }
}

