  'admin_delivery', 'lang_en', 'lang_am'
];

comingSoon.forEach(cmd => {
  bot.callbackQuery(cmd, async (ctx) => {
    await ctx.answerCallbackQuery();
    await ctx.reply(`⏳ *${cmd.replace('_', ' ').toUpperCase()}*\n\nComing soon.`, {
      parse_mode: 'Markdown',
      reply_markup: {
        inline_keyboard: [[{ text: '🔙 Menu', callback_data: 'admin_menu' }]],
      },
    });
  });
});

// ============================================================
// START BOT
// ============================================================

console.log('🤖 Admin Bot running');
console.log(`👥 Admins: ${ADMIN_IDS.join(', ')}`);

bot.start({ allowed_updates: ['message', 'callback_query'] });

// Health check
http.createServer((req, res) => {
  if (req.url === '/health') {
    res.writeHead(200, { 'Content-Type': 'application/json' });
    res.end(JSON.stringify({ status: 'ok', service: 'admin-bot', port: PORT }));
  } else {
    res.writeHead(404);
    res.end('Not Found');
  }
}).listen(PORT, '0.0.0.0', () => {
  console.log(`✅ Health: http://localhost:${PORT}/health`);
});

