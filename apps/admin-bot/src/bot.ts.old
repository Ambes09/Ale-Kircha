        msg += `   👤 ${t.customerName || 'N/A'}\n`;
        msg += `   📌 ${t.category || 'General'}\n\n`;
      }
      if (tickets.length > 10) msg += `... ${tickets.length - 10} more\n`;
    } else {
      msg += 'No support tickets found.';
