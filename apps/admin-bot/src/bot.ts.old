// Settings handlers
async function showSetting(ctx: any, key: string, label: string) {
  try {
    const data = await apiCall('/api/v1/settings');
    const settings = data.data || {};
    const value = settings[key] || 'Not configured';
    await ctx.reply(`⚙️ *${label}*\n\nCurrent value: ${value}`, {
      parse_mode: 'Markdown',
      reply_markup: {
        inline_keyboard: [
          [{ text: '✏️ Edit', callback_data: `settings_edit_${key}` }],
          [{ text: '🔙 Back', callback_data: 'admin_settings' }],
        ],
      },
    });
  } catch {
    await ctx.reply('❌ Failed to load setting.', {
      reply_markup: { inline_keyboard: [[{ text: '🔙 Back', callback_data: 'admin_settings' }]] },
    });
  }
}

bot.callbackQuery('settings_language', async (ctx) => {
  await ctx.answerCallbackQuery();
  await showSetting(ctx, 'language', 'Language');
});

