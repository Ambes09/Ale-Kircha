// Health check server
http.createServer((req, res) => {
  if (req.url === '/health') {
    res.writeHead(200, { 'Content-Type': 'application/json' });
    res.end(JSON.stringify({ status: 'ok', service: 'admin-bot', port: PORT }));
  } else {
    res.writeHead(404);
    res.end('Not Found');
  }
}).listen(PORT, '0.0.0.0', () => {
  console.log(`✅ Health check: http://localhost:${PORT}/health`);
});

// ============================================================
// ADMIN DELIVERY
// ============================================================

bot.callbackQuery('admin_delivery', async (ctx) => {
  await ctx.answerCallbackQuery();
  try {
    const data = await apiCall('/api/v1/deliveries');
    const deliveries = data.data || [];
    let msg = '🚚 *DELIVERY MANAGEMENT*\n\n';
    
    if (deliveries.length) {
      for (const d of deliveries.slice(0, 10)) {
        const emoji = d.status === 'PENDING' ? '🟡' : 
                      d.status === 'OUT_FOR_DELIVERY' ? '🚚' : 
                      d.status === 'DELIVERED' ? '✅' : '📌';
        msg += `${emoji} *${d.orderNumber || 'N/A'}*\n`;
        msg += `   👤 ${d.customername || d.customerName || 'N/A'}\n`;
        msg += `   📍 ${d.deliveryaddress || d.deliveryAddress || 'N/A'}\n`;
        msg += `   🔹 ${d.status}\n\n`;
      }
      if (deliveries.length > 10) msg += `... ${deliveries.length - 10} more\n`;
    } else {
      msg += 'No deliveries found.';
    }
    
    await ctx.reply(msg, {
      parse_mode: 'Markdown',
      reply_markup: {
        inline_keyboard: [
          [{ text: '📋 Pending', callback_data: 'delivery_pending' }],
          [{ text: '🚚 Out for Delivery', callback_data: 'delivery_out' }],
          [{ text: '✅ Delivered', callback_data: 'delivery_delivered' }],
          [{ text: '🔙 Menu', callback_data: 'admin_menu' }],
        ],
      },
    });
  } catch (error) {
    await ctx.reply('❌ Failed to load deliveries.', {
      reply_markup: { inline_keyboard: [[{ text: '🔙 Menu', callback_data: 'admin_menu' }]] },
    });
  }
});

// Delivery sub-filters
bot.callbackQuery('delivery_pending', async (ctx) => {
  await ctx.answerCallbackQuery();
  try {
    const data = await apiCall('/api/v1/deliveries');
    const pending = (data.data || []).filter((d: any) => d.status === 'PENDING' || d.status === 'UNASSIGNED');
    let msg = '📋 *PENDING DELIVERIES*\n\n';
    if (pending.length) {
      for (const d of pending.slice(0, 10)) {
        msg += `📌 ${d.orderNumber || 'N/A'}\n   👤 ${d.customername || d.customerName || 'N/A'}\n\n`;
      }
    } else {
      msg += 'No pending deliveries.';
    }
    await ctx.reply(msg, { parse_mode: 'Markdown' });
  } catch {
    await ctx.reply('❌ Failed to load.');
  }
});

bot.callbackQuery('delivery_out', async (ctx) => {
  await ctx.answerCallbackQuery();
  try {
    const data = await apiCall('/api/v1/deliveries');
    const out = (data.data || []).filter((d: any) => d.status === 'OUT_FOR_DELIVERY' || d.status === 'ASSIGNED');
    let msg = '🚚 *OUT FOR DELIVERY*\n\n';
    if (out.length) {
      for (const d of out.slice(0, 10)) {
        msg += `📌 ${d.orderNumber || 'N/A'}\n   👤 ${d.customername || d.customerName || 'N/A'}\n\n`;
      }
    } else {
      msg += 'No deliveries out.';
    }
    await ctx.reply(msg, { parse_mode: 'Markdown' });
  } catch {
    await ctx.reply('❌ Failed to load.');
  }
});

bot.callbackQuery('delivery_delivered', async (ctx) => {
  await ctx.answerCallbackQuery();
  try {
    const data = await apiCall('/api/v1/deliveries');
    const delivered = (data.data || []).filter((d: any) => d.status === 'DELIVERED' || d.status === 'COMPLETED');
    let msg = '✅ *DELIVERED ORDERS*\n\n';
    if (delivered.length) {
      for (const d of delivered.slice(0, 10)) {
        msg += `📌 ${d.orderNumber || 'N/A'}\n   👤 ${d.customername || d.customerName || 'N/A'}\n   📅 ${new Date(d.updatedAt).toLocaleDateString()}\n\n`;
      }
    } else {
      msg += 'No delivered orders.';
    }
    await ctx.reply(msg, { parse_mode: 'Markdown' });
  } catch {
    await ctx.reply('❌ Failed to load.');
  }
});

