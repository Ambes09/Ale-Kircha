// ============================================================
// ADMIN NOTIFICATIONS
// ============================================================

async function getNotifications(ctx: any) {
  try {
    const data = await apiCall('/api/v1/admin/notifications/recent', {}, ctx);
    const notifications = data.data || [];
    let msg = '🔔 *NOTIFICATIONS*\n\n';
    
    if (notifications.length) {
      for (const n of notifications.slice(0, 10)) {
        const emoji = n.type === 'CUSTOMER_REGISTERED' ? '🆕' :
                      n.type === 'PAYMENT_SUBMITTED' ? '💳' :
                      n.type === 'REFUND_REQUESTED' ? '↩️' :
                      n.type === 'GROUP_REQUESTED' ? '🥩' : '📌';
        msg += `${emoji} *${n.title}*\n`;
        msg += `${n.body?.substring(0, 100)}...\n`;
        msg += `📅 ${new Date(n.createdAt).toLocaleString()}\n\n`;
      }
      if (notifications.length > 10) msg += `... ${notifications.length - 10} more\n`;
    } else {
      msg += 'No new notifications.';
    }
    
    await ctx.reply(msg, {
      parse_mode: 'Markdown',
      reply_markup: {
        inline_keyboard: [
          [{ text: '✅ Mark All Read', callback_data: 'notifications_read_all' }],
          [{ text: '🔙 Menu', callback_data: 'admin_menu' }],
        ],
      },
    });
  } catch {
    await ctx.reply('❌ Failed to load notifications.', {
      reply_markup: { inline_keyboard: [[{ text: '🔙 Menu', callback_data: 'admin_menu' }]] },
    });
  }
}

// Add notification button to main menu
// Update main menu to include notifications
async function showMainMenu(ctx: any) {
  try {
    const countData = await apiCall('/api/v1/admin/notifications/count', {}, ctx);
    const count = countData.data?.unread || 0;
    const notifyText = count > 0 ? `🔔 Notifications (${count})` : '🔔 Notifications';
    
    await ctx.reply(
      '🏗️ *ALE KIRCHA ADMIN*\n\nSelect option:',
      {
        parse_mode: 'Markdown',
        reply_markup: {
          inline_keyboard: [
            [{ text: '📊 Dashboard', callback_data: 'admin_dashboard' }, { text: '👥 Users', callback_data: 'admin_customers' }],
            [{ text: '🥩 Groups', callback_data: 'admin_groups' }, { text: '📦 Orders', callback_data: 'admin_orders' }],
            [{ text: '💳 Payments', callback_data: 'admin_payments' }, { text: '🔄 Refunds', callback_data: 'admin_refunds' }],
            [{ text: '🚚 Delivery', callback_data: 'admin_delivery' }, { text: '📈 Reports', callback_data: 'admin_reports' }],
            [{ text: '💵 Fees', callback_data: 'admin_fees' }, { text: '⚙️ Settings', callback_data: 'admin_settings' }],
            [{ text: '👤 Admins', callback_data: 'admin_users' }, { text: '📋 Audit', callback_data: 'admin_audit' }],
            [{ text: '📞 Support', callback_data: 'admin_support' }, { text: '❓ FAQ', callback_data: 'admin_faq' }],
            [{ text: '📜 Terms', callback_data: 'admin_terms' }, { text: 'ℹ️ About', callback_data: 'admin_about' }],
            [{ text: notifyText, callback_data: 'admin_notifications' }, { text: '🌐 Language', callback_data: 'admin_language' }],
          ],
        },
      }
    );
  } catch {
    // Fallback menu without notification count
    await ctx.reply(
      '🏗️ *ALE KIRCHA ADMIN*\n\nSelect option:',
      {
        parse_mode: 'Markdown',
        reply_markup: {
          inline_keyboard: [
            [{ text: '📊 Dashboard', callback_data: 'admin_dashboard' }, { text: '👥 Users', callback_data: 'admin_customers' }],
            [{ text: '🥩 Groups', callback_data: 'admin_groups' }, { text: '📦 Orders', callback_data: 'admin_orders' }],
            [{ text: '💳 Payments', callback_data: 'admin_payments' }, { text: '🔄 Refunds', callback_data: 'admin_refunds' }],
            [{ text: '🚚 Delivery', callback_data: 'admin_delivery' }, { text: '📈 Reports', callback_data: 'admin_reports' }],
            [{ text: '💵 Fees', callback_data: 'admin_fees' }, { text: '⚙️ Settings', callback_data: 'admin_settings' }],
            [{ text: '👤 Admins', callback_data: 'admin_users' }, { text: '📋 Audit', callback_data: 'admin_audit' }],
            [{ text: '📞 Support', callback_data: 'admin_support' }, { text: '❓ FAQ', callback_data: 'admin_faq' }],
            [{ text: '📜 Terms', callback_data: 'admin_terms' }, { text: 'ℹ️ About', callback_data: 'admin_about' }],
            [{ text: '🔔 Notifications', callback_data: 'admin_notifications' }, { text: '🌐 Language', callback_data: 'admin_language' }],
          ],
        },
      }
    );
  }
}

// Notification callback
bot.callbackQuery('admin_notifications', async (ctx) => {
  await ctx.answerCallbackQuery();
  await getNotifications(ctx);
});

// Mark all notifications as read
bot.callbackQuery('notifications_read_all', async (ctx) => {
  await ctx.answerCallbackQuery();
  try {
    // Mark all as read via API
    await apiCall('/api/v1/admin/notifications/mark-all-read', { method: 'PUT' }, ctx);
    await ctx.reply('✅ All notifications marked as read.', {
      reply_markup: {
        inline_keyboard: [[{ text: '🔙 Menu', callback_data: 'admin_menu' }]],
      },
    });
  } catch {
    await ctx.reply('❌ Failed to mark notifications as read.', {
      reply_markup: { inline_keyboard: [[{ text: '🔙 Menu', callback_data: 'admin_menu' }]] },
    });
  }
});

// ============================================================
// BANK ACCOUNT MANAGEMENT
// ============================================================

bot.callbackQuery('admin_banks', async (ctx) => {
  await ctx.answerCallbackQuery();
  try {
    const data = await apiCall('/api/v1/admin/banks', {}, ctx);
    const banks = data.data || [];
    let msg = '🏦 *BANK ACCOUNTS*\n\n';
    
    if (banks.length) {
      for (const b of banks) {
        msg += `📌 *${b.bankNameEn}* (${b.bankNameAm})\n`;
        msg += `   📱 ${b.accountName}\n`;
        msg += `   🔢 ${b.accountNumber}\n`;
        msg += `   ${b.isActive ? '🟢 Active' : '🔴 Inactive'}`;
        if (b.isDefault) msg += ' ⭐ Default';
        msg += '\n\n';
      }
    } else {
      msg += 'No bank accounts configured.';
    }
    
    await ctx.reply(msg, {
      parse_mode: 'Markdown',
      reply_markup: {
        inline_keyboard: [
          [{ text: '➕ Add Bank', callback_data: 'bank_add' }],
          [{ text: '✏️ Edit', callback_data: 'bank_edit' }],
          [{ text: '🗑️ Delete', callback_data: 'bank_delete' }],
          [{ text: '🔙 Menu', callback_data: 'admin_menu' }],
        ],
      },
    });
  } catch {
    await ctx.reply('❌ Failed to load bank accounts.', {
      reply_markup: { inline_keyboard: [[{ text: '🔙 Menu', callback_data: 'admin_menu' }]] },
    });
  }
});

// Add bank - step by step
bot.callbackQuery('bank_add', async (ctx) => {
  await ctx.answerCallbackQuery();
  await ctx.reply(
    '➕ *ADD BANK ACCOUNT*\n\n' +
    'Send me the bank details:\n\n' +
    '📌 Bank Name (English): Commercial Bank of Ethiopia\n' +
    '📌 Bank Name (Amharic): የኢትዮጵያ ንግድ ባንክ\n' +
    '📌 Account Name: Ale Kircha\n' +
    '📌 Account Number: 1000123456789\n' +
    '📌 Branch: Head Office (Optional)\n' +
    '📌 Account Type: checking (Optional)\n' +
    '📌 Set as Default: yes/no\n\n' +
    'Example format:\n' +
    'bankNameEn: Commercial Bank of Ethiopia\n' +
    'bankNameAm: የኢትዮጵያ ንግድ ባንክ\n' +
    'accountName: Ale Kircha\n' +
    'accountNumber: 1000123456789',
    {
      parse_mode: 'Markdown',
      reply_markup: {
        inline_keyboard: [[{ text: '🔙 Back', callback_data: 'admin_banks' }]],
      },
    }
  );
});

// Edit bank - show list to edit
bot.callbackQuery('bank_edit', async (ctx) => {
  await ctx.answerCallbackQuery();
  try {
    const data = await apiCall('/api/v1/admin/banks', {}, ctx);
    const banks = data.data || [];
    let msg = '✏️ *EDIT BANK ACCOUNT*\n\nSelect a bank to edit:\n\n';
    
    if (banks.length) {
      const buttons = banks.map((b: any) => ([
        { text: `${b.bankNameEn}`, callback_data: `bank_edit_${b.id}` }
      ]));
      buttons.push([{ text: '🔙 Back', callback_data: 'admin_banks' }]);
      
      await ctx.reply(msg, {
        parse_mode: 'Markdown',
        reply_markup: {
          inline_keyboard: buttons,
        },
      });
    } else {
      await ctx.reply('No bank accounts to edit.', {
        reply_markup: { inline_keyboard: [[{ text: '🔙 Back', callback_data: 'admin_banks' }]] },
      });
    }
  } catch {
    await ctx.reply('❌ Failed to load banks.', {
      reply_markup: { inline_keyboard: [[{ text: '🔙 Back', callback_data: 'admin_banks' }]] },
    });
  }
});

// Delete bank - show list to delete
bot.callbackQuery('bank_delete', async (ctx) => {
  await ctx.answerCallbackQuery();
  try {
    const data = await apiCall('/api/v1/admin/banks', {}, ctx);
    const banks = data.data || [];
    let msg = '🗑️ *DELETE BANK ACCOUNT*\n\nSelect a bank to delete:\n\n';
    
    if (banks.length) {
      const buttons = banks.filter((b: any) => !b.isDefault).map((b: any) => ([
        { text: `❌ ${b.bankNameEn}`, callback_data: `bank_delete_${b.id}` }
      ]));
      buttons.push([{ text: '🔙 Back', callback_data: 'admin_banks' }]);
      
      await ctx.reply(msg + '⚠️ Default bank cannot be deleted.', {
        parse_mode: 'Markdown',
        reply_markup: {
          inline_keyboard: buttons,
        },
      });
    } else {
      await ctx.reply('No bank accounts to delete.', {
        reply_markup: { inline_keyboard: [[{ text: '🔙 Back', callback_data: 'admin_banks' }]] },
      });
    }
  } catch {
    await ctx.reply('❌ Failed to load banks.', {
      reply_markup: { inline_keyboard: [[{ text: '🔙 Back', callback_data: 'admin_banks' }]] },
    });
  }
});

// Handle bank edit/delete callbacks
bot.callbackQuery(/bank_(edit|delete)_(.+)/, async (ctx) => {
  await ctx.answerCallbackQuery();
  const action = ctx.match[1];
  const id = ctx.match[2];
  
  if (action === 'edit') {
    await ctx.reply(`✏️ *EDIT BANK*\n\nSend me the updated details for bank ID: ${id}\n\nSame format as when adding:`, {
      parse_mode: 'Markdown',
      reply_markup: { inline_keyboard: [[{ text: '🔙 Back', callback_data: 'admin_banks' }]] },
    });
  } else if (action === 'delete') {
    // Confirm deletion
    await ctx.reply(`⚠️ *CONFIRM DELETE*\n\nAre you sure you want to delete this bank account?\n\nThis action cannot be undone.`, {
      parse_mode: 'Markdown',
      reply_markup: {
        inline_keyboard: [
          [{ text: '✅ Yes, Delete', callback_data: `bank_confirm_delete_${id}` }],
          [{ text: '❌ Cancel', callback_data: 'admin_banks' }],
        ],
      },
    });
  }
});

// Confirm delete
bot.callbackQuery(/bank_confirm_delete_(.+)/, async (ctx) => {
  await ctx.answerCallbackQuery();
  const id = ctx.match[1];
  try {
    const result = await apiCall(`/api/v1/admin/banks/${id}`, { method: 'DELETE' }, ctx);
    if (result.success) {
      await ctx.reply('✅ Bank account deleted successfully!', {
        reply_markup: { inline_keyboard: [[{ text: '🔙 Back', callback_data: 'admin_banks' }]] },
      });
    } else {
      await ctx.reply(`❌ Failed to delete: ${result.error || 'Unknown error'}`, {
        reply_markup: { inline_keyboard: [[{ text: '🔙 Back', callback_data: 'admin_banks' }]] },
      });
    }
  } catch {
    await ctx.reply('❌ Failed to delete bank account.', {
      reply_markup: { inline_keyboard: [[{ text: '🔙 Back', callback_data: 'admin_banks' }]] },
    });
  }
});
