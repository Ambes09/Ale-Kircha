    const rules = [
      { key: 'max_groups_per_user', label: 'Max Groups per User' },
      { key: 'max_members_per_group', label: 'Max Members per Group' },
      { key: 'group_expiry_days', label: 'Group Expiry (days)' },
      { key: 'refund_confirmation_hours', label: 'Refund Confirmation (hours)' },
      { key: 'refund_processing_hours', label: 'Refund Processing (hours)' },
    ];
    for (const rule of rules) {
      const value = settings[rule.key] || 'Not set';
      msg += `📌 ${rule.label}: ${value}\n`;
    }
    await ctx.reply(msg, {
      parse_mode: 'Markdown',
      reply_markup: {
        inline_keyboard: [
          [{ text: '✏️ Edit', callback_data: 'settings_edit_rules' }],
          [{ text: '🔙 Back', callback_data: 'admin_settings' }],
        ],
      },
    });
  } catch {
    await ctx.reply('❌ Failed to load rules.', {
      reply_markup: { inline_keyboard: [[{ text: '🔙 Back', callback_data: 'admin_settings' }]] },
    });
  }
});

