bot.callbackQuery('payments_pending', async (ctx) => {
  await ctx.answerCallbackQuery();
  try {
    const data = await apiCall('/api/v1/payments', {}, ctx);
    const pending = (data.data || []).filter((p: any) => p.status === 'PENDING' || p.status === 'SUBMITTED');
    let msg = '🟡 *PENDING PAYMENTS*\n\n';
    if (pending.length) {
      for (const p of pending.slice(0, 10)) {
        msg += `📌 ${p.paymentId || p.id}\n`;
        msg += `   💰 ${formatCurrency(p.amount || 0)}\n`;
        msg += `   👤 ${p.customerName || 'N/A'}\n\n`;
      }
      if (pending.length > 10) msg += `... ${pending.length - 10} more\n`;
    } else {
      msg += 'No pending payments found.';
    }
    await ctx.reply(msg, {
      parse_mode: 'Markdown',
      reply_markup: {
        inline_keyboard: [[{ text: '🔙 Back', callback_data: 'admin_payments' }]],
      },
    });
  } catch {
    await ctx.reply('❌ Failed to load pending payments.', {
      reply_markup: { inline_keyboard: [[{ text: '🔙 Back', callback_data: 'admin_payments' }]] },
    });
  }
});

