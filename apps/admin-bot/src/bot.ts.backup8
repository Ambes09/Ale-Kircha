    for (const g of open.slice(0, 10)) {
      const avail = (g.maxQuota || 0) - (g.consumedQuota || 0);
      msg += `📌 ${g.name}\n   📦 ${avail.toFixed(1)}/${g.maxQuota || 0}\n\n`;
    }
    if (open.length > 10) msg += `... ${open.length - 10} more\n`;
