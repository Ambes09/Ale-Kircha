      },
    }
  );
});

// Handle search input
bot.on('message:text', async (ctx) => {
  // Check if we're in search mode - simplified, will show all customers
  const text = ctx.message.text;
  if (text && text.length > 2) {
    try {
      const data = await apiCall('/api/v1/customers', {}, ctx);
      const customers = (data.data || []).filter((c: any) => 
        c.fullName?.toLowerCase().includes(text.toLowerCase()) ||
        c.user?.phone?.includes(text) ||
        c.user?.telegramId?.includes(text)
      );
      let msg = '🔍 *SEARCH RESULTS*\n\n';
      if (customers.length) {
        for (const c of customers.slice(0, 10)) {
          msg += `📛 ${c.fullName || 'N/A'}\n`;
          msg += `   📱 ${c.user?.phone || 'N/A'}\n\n`;
        }
        if (customers.length > 10) msg += `... ${customers.length - 10} more\n`;
      } else {
        msg += 'No customers found matching your search.';
      }
      await ctx.reply(msg, {
        parse_mode: 'Markdown',
        reply_markup: {
          inline_keyboard: [[{ text: '🔙 Back', callback_data: 'admin_customers' }]],
        },
      });
    } catch {
      await ctx.reply('❌ Search failed.', {
        reply_markup: { inline_keyboard: [[{ text: '🔙 Back', callback_data: 'admin_customers' }]] },
      });
    }
  }
});

