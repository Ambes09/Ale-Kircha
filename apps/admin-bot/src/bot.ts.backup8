// ============================================================
// REPORTS - SALES, ORDERS, PAYMENTS, CUSTOMERS, GROUPS, DELIVERY
// ============================================================

async function generateReport(ctx: any, type: string, title: string) {
  try {
    const data = await apiCall(`/api/v1/admin/reports/${type}`, {}, ctx);
    const d = data.data || {};
    let msg = `📊 *${title}*\n\n`;
    if (Object.keys(d).length) {
      for (const [key, value] of Object.entries(d)) {
        msg += `📌 ${key}: ${value}\n`;
      }
    } else {
      msg += 'No data available.';
    }
    await ctx.reply(msg, {
