bot.callbackQuery('admin_orders', async (ctx) => {
  await ctx.answerCallbackQuery();
  const result = await safeApiCall('/api/v1/orders', {}, ctx);
  const orders = result.data || [];
  let msg = '📦 *ORDERS*\n\n';
  if (orders.length) {
    for (const o of orders.slice(0, 10)) {
      const emoji = o.orderStatus === 'PENDING' ? '🟡' : o.orderStatus === 'COMPLETED' ? '✅' : '❌';
      msg += `${emoji} *${o.orderNumber || 'N/A'}*\n`;
      msg += `   💰 ${formatCurrency(o.totalAmount || 0)}\n`;
      msg += `   👤 ${o.customer?.fullName || 'N/A'}\n\n`;
    }
    if (orders.length > 10) msg += `... ${orders.length - 10} more\n`;
  } else {
    msg += 'No orders found.';
  }
  if (result.mock) msg += '\nℹ️ Demo data';
