// Report handlers
const reportHandlers = ['sales', 'orders', 'payments', 'customers', 'groups'];
reportHandlers.forEach(type => {
  bot.callbackQuery(`report_${type}`, async (ctx) => {
    await ctx.answerCallbackQuery();
    const result = await safeApiCall(`/api/v1/admin/reports/${type}`, {}, ctx);
    const data = result.data || {};
    let msg = `📊 *${type.toUpperCase()} REPORT*\n\n`;
    if (Object.keys(data).length) {
      for (const [key, value] of Object.entries(data)) {
        msg += `${key}: ${value}\n`;
      }
    } else {
      msg += 'No data available.';
    }
    if (result.mock) msg += '\nℹ️ Demo data';
    await ctx.reply(msg, {
      parse_mode: 'Markdown',
      reply_markup: { inline_keyboard: [[{ text: '🔙 Back', callback_data: 'admin_reports' }]] },
    });
  });
});

