bot.callbackQuery('customers_search', async (ctx) => {
  await ctx.answerCallbackQuery();
  await ctx.reply(
    '🔍 *SEARCH CUSTOMERS*\n\n' +
    'Send me the customer name, phone number, or Telegram ID to search.\n\n' +
    'Example:\n' +
    'Abebe Kebede\n' +
    'or\n' +
    '+251911111111',
    {
      parse_mode: 'Markdown',
